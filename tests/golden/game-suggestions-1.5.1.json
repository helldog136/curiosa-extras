{
 "manifest": {
  "apiVersion": 2,
  "id": "game-suggestions",
  "name": {
   "en": "Game suggestions",
   "fr": "Suggestions de jeux"
  },
  "description": {
   "en": "Let your audience suggest what to play: a public list with statuses (proposed, planned, played…), a suggestion form, \"play it again\" votes on games you already played. You can also add games to the list yourself, one at a time or a whole list. Covers are found automatically.",
   "fr": "Laissez votre communauté suggérer à quoi jouer : une liste publique avec statuts (proposé, planifié, joué…), un formulaire de suggestion, des votes « rejoue-le » sur les jeux déjà joués. Vous pouvez aussi ajouter vous-même des jeux à la liste, un par un ou toute une liste. Les jaquettes sont trouvées automatiquement."
  },
  "author": "Helldog136",
  "privacy": {
   "en": "If you suggest a game, the game's name, your first name or nickname (if you give one) and your note are saved and shown publicly on the suggestions page. If you vote to replay a game, a small cookie on your browser remembers your votes for the month. Game covers are loaded by your browser from RAWG (or from the image address chosen by the site), which sees your address. To have a suggestion removed, write to the site's contact.",
   "fr": "Si vous proposez un jeu, le nom du jeu, votre prénom ou pseudo (si vous en donnez un) et votre note sont enregistrés et affichés publiquement sur la page des suggestions. Si vous votez pour rejouer un jeu, un petit cookie sur votre navigateur retient vos votes du mois. Les jaquettes sont chargées par votre navigateur depuis RAWG (ou depuis l'adresse d'image choisie par le site), qui voit votre adresse. Pour faire retirer une suggestion, écrivez au contact du site."
  },
  "license": "MIT",
  "icon": "🎮",
  "main": "index.mjs",
  "type": "widget",
  "instances": "single",
  "page": true,
  "basePath": "suggestions",
  "permissions": [
   "pages",
   "routes",
   "storage",
   "admin",
   "mcp",
   "rawg"
  ],
  "requires": [
   {
    "service": "game.cover",
    "optional": true
   }
  ],
  "tabs": [
   {
    "id": "use",
    "label": {
     "fr": "Suggestions",
     "en": "Suggestions"
    }
   }
  ],
  "settings": [
   {
    "key": "title",
    "type": "text",
    "label": {
     "en": "Page title",
     "fr": "Titre de la page"
    }
   },
   {
    "key": "intro",
    "type": "textarea",
    "label": {
     "en": "Introduction (Markdown)",
     "fr": "Introduction (Markdown)"
    }
   },
   {
    "key": "rateLimit",
    "type": "number",
    "default": 5,
    "advanced": true,
    "label": {
     "en": "Suggestions per hour and visitor",
     "fr": "Suggestions par heure et par personne"
    }
   },
   {
    "key": "maxVotesPerMonth",
    "type": "number",
    "default": 3,
    "advanced": true,
    "label": {
     "en": "\"Play it again\" votes per visitor and month",
     "fr": "Votes « rejoue-le » par personne et par mois"
    }
   }
  ],
  "mcp": [
   {
    "name": "game_suggestions_list",
    "readOnly": true,
    "description": "List game suggestions, newest first. Optional filter by status.",
    "input": {
     "type": "object",
     "properties": {
      "status": {
       "type": "string",
       "enum": [
        "proposed",
        "planned",
        "accepted",
        "rejected",
        "already_played",
        "finished"
       ],
       "description": "Only this status."
      },
      "limit": {
       "type": "integer",
       "minimum": 1,
       "maximum": 100,
       "description": "How many at most (default 30)."
      }
     }
    }
   },
   {
    "name": "game_suggestions_add",
    "description": "Add one or several games to the list (50 at most at a time), as the site's administration would. Default status: already_played. A title already in the list is refused and nothing is added. The cover is looked up automatically.",
    "input": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string",
       "maxLength": 100,
       "description": "Name of the game (use this or titles)."
      },
      "titles": {
       "type": "array",
       "maxItems": 50,
       "items": {
        "type": "string",
        "maxLength": 100
       },
       "description": "Several names at once, one game each."
      },
      "status": {
       "type": "string",
       "enum": [
        "proposed",
        "planned",
        "accepted",
        "rejected",
        "already_played",
        "finished"
       ],
       "description": "Default already_played."
      },
      "note": {
       "type": "string",
       "maxLength": 280,
       "description": "Optional note (single title only)."
      },
      "imageUrl": {
       "type": "string",
       "maxLength": 500,
       "description": "Optional https:// address of an image, if no cover is found (single title only)."
      }
     }
    }
   },
   {
    "name": "game_suggestions_set_status",
    "description": "Change the status of a game suggestion.",
    "input": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string",
       "description": "Suggestion id."
      },
      "status": {
       "type": "string",
       "enum": [
        "proposed",
        "planned",
        "accepted",
        "rejected",
        "already_played",
        "finished"
       ]
      }
     },
     "required": [
      "id",
      "status"
     ]
    }
   }
  ],
  "dataVersion": 2,
  "legacySettings": [
   {
    "key": "rawgApiKey",
    "secret": true
   }
  ]
 },
