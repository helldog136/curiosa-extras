{
  "apiVersion": 2,
  "minCore": "0.6.0",
  "id": "announcement-banner",
  "name": {
    "en": "Announcement banner",
    "fr": "Bannière d'annonce"
  },
  "version": "1.1.0",
  "description": {
    "en": "A banner at the top of every page that can have dates, and a note for the home page. Example module.",
    "fr": "Un bandeau en haut de chaque page, qui peut avoir des dates, et une note pour l'accueil. Module d'exemple."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "📣",
  "main": "index.mjs",
  "permissions": [
    "slots",
    "sections",
    "topics"
  ],
  "settings": [
    {
      "key": "enabled",
      "type": "boolean",
      "label": {
        "en": "Show the banner",
        "fr": "Afficher la bannière"
      },
      "default": true
    },
    {
      "key": "text",
      "type": "text",
      "translatable": true,
      "label": {
        "en": "Banner text",
        "fr": "Texte de la bannière"
      },
      "help": {
        "en": "One text per language. Empty = nothing shown in that language.",
        "fr": "Un texte par langue. Vide = rien dans cette langue."
      },
      "example": {
        "en": "Free delivery until Sunday",
        "fr": "Livraison offerte jusqu'à dimanche"
      }
    },
    {
      "key": "link",
      "type": "url",
      "label": {
        "en": "Link (optional)",
        "fr": "Lien (facultatif)"
      },
      "optional": true,
      "example": "https://example.org/news"
    },
    {
      "key": "tone",
      "type": "select",
      "label": {
        "en": "Style",
        "fr": "Style"
      },
      "default": "info",
      "options": [
        {
          "value": "info",
          "label": {
            "en": "Accent",
            "fr": "Accent"
          }
        },
        {
          "value": "success",
          "label": {
            "en": "Green",
            "fr": "Vert"
          }
        },
        {
          "value": "warning",
          "label": {
            "en": "Amber",
            "fr": "Ambre"
          }
        }
      ]
    },
    {
      "key": "homeText",
      "type": "textarea",
      "translatable": true,
      "label": {
        "en": "Home page note (Markdown)",
        "fr": "Note sur l'accueil (Markdown)"
      },
      "example": {
        "en": "Welcome, here is what is new",
        "fr": "Bienvenue, voici les nouveautés"
      }
    },
    {
      "key": "period",
      "type": "period",
      "rare": true,
      "optional": true,
      "label": {
        "en": "Limit in time",
        "fr": "Limiter dans le temps"
      },
      "help": {
        "en": "Outside these dates, nothing is shown.",
        "fr": "Hors de ces dates, rien n'est affiché."
      },
      "example": {
        "en": "From 1 December to 24 December, every year",
        "fr": "Du 1er décembre au 24 décembre, chaque année"
      }
    }
  ],
  "instances": "multiple",
  "sections": [
    {
      "id": "note",
      "label": {
        "en": "Note",
        "fr": "Note"
      }
    }
  ],
  "provides": [
    {
      "topic": "overlay.item",
      "label": {
        "en": "Banner text as an overlay item",
        "fr": "Texte de la bannière comme élément d'overlay"
      }
    }
  ]
}