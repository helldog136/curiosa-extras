{
  "apiVersion": 2,
  "minCore": "0.6.0",
  "id": "github",
  "name": {
    "en": "GitHub",
    "fr": "GitHub"
  },
  "version": "1.2.1",
  "platform": "github",
  "description": {
    "en": "Shows your GitHub button in the site header and shares your follower count.",
    "fr": "Affiche le bouton de votre GitHub dans l'en-tête et partage vos followers."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "💻",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "GitHub button in the header",
        "fr": "Bouton GitHub dans l'en-tête"
      }
    },
    {
      "topic": "social.stat",
      "label": {
        "en": "GitHub followers",
        "fr": "Followers GitHub"
      }
    }
  ],
  "permissions": [
    "admin"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Statistiques",
        "en": "Statistics"
      }
    }
  ],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://github.com/myname",
        "fr": "https://github.com/monpseudo"
      }
    },
    {
      "key": "trackStats",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Follow my statistics",
        "fr": "Suivre mes statistiques"
      },
      "help": {
        "en": "Counts your followers for the site's statistics. This number is public: nothing to set up.",
        "fr": "Compte vos followers pour les statistiques du site. Ce chiffre est public : rien à régler."
      }
    }
  ],
  "social": {
    "name": "GitHub",
    "icon": "github",
    "hosts": [
      "github.com"
    ],
    "template": "https://github.com/{h}",
    "example": {
      "en": "https://github.com/myname",
      "fr": "https://github.com/monpseudo"
    },
    "shapes": [
      {
        "re": "^/@?(?!(?:orgs|settings|marketplace|sponsors|topics|features|login|about|pricing|explore|notifications)(?:/|$))([A-Za-z0-9-]{1,39})/?$",
        "handle": true
      }
    ]
  }
}
