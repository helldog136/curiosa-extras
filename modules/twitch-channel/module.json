{
  "apiVersion": 2,
  "id": "twitch-channel",
  "name": {
    "en": "Twitch channel",
    "fr": "Chaîne Twitch"
  },
  "version": "1.1.0",
  "platform": "twitch",
  "description": {
    "en": "Makes your Twitch channel easier to showcase: header button, live status and latest clips.",
    "fr": "Facilite la mise en avant de votre chaîne Twitch : bouton, statut en direct et derniers clips."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "🟣",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "offers": [
    {
      "service": "twitch.live",
      "label": {
        "en": "Twitch channel status (live or not)",
        "fr": "État de la chaîne Twitch (en direct ou non)"
      },
      "readOnly": [
        "channel",
        "status"
      ]
    }
  ],
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Twitch button in the header",
        "fr": "Bouton Twitch dans l'en-tête"
      }
    },
    {
      "topic": "stream.live",
      "label": {
        "en": "Current live stream",
        "fr": "Live en cours"
      }
    },
    {
      "topic": "maze.poster",
      "label": {
        "en": "Latest clips as posters",
        "fr": "Derniers clips en affiches"
      }
    }
  ],
  "permissions": [
    "topics",
    "storage",
    "admin"
  ],
  "settings": [
    {
      "key": "channel",
      "type": "text",
      "label": {
        "en": "Twitch channel (login)",
        "fr": "Chaîne Twitch (identifiant)"
      },
      "help": {
        "en": "For example mychannel. Shared with the other Twitch modules: type it only here.",
        "fr": "Par exemple machaine. Partagée avec les autres modules Twitch : à saisir ici seulement."
      }
    },
    {
      "key": "clientId",
      "type": "text",
      "label": {
        "en": "Twitch client id",
        "fr": "Client id Twitch"
      },
      "help": {
        "en": "From dev.twitch.tv/console (an application of your own). Type it only here.",
        "fr": "Depuis dev.twitch.tv/console (une application à vous). À saisir ici seulement."
      }
    },
    {
      "key": "clientSecret",
      "type": "secret",
      "label": {
        "en": "Twitch client secret",
        "fr": "Client secret Twitch"
      }
    }
  ]
}
