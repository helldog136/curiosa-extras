{
  "apiVersion": 2,
  "id": "twitch-channel",
  "name": {
    "en": "Twitch channel",
    "fr": "Chaîne Twitch"
  },
  "version": "1.0.2",
  "platform": "twitch",
  "description": {
    "en": "Makes your Twitch channel easier to showcase: shows when you are live and offers your latest clips.",
    "fr": "Facilite la mise en avant de votre chaîne Twitch : indique quand vous êtes en direct et propose vos derniers clips."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "🟣",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Twitch button in the header",
        "fr": "Bouton Twitch dans l'en-tête"
      }
    },
    {
      "topic": "stream.live",
      "label": {
        "en": "Current live stream",
        "fr": "Live en cours"
      }
    },
    {
      "topic": "maze.poster",
      "label": {
        "en": "Latest clips as posters",
        "fr": "Derniers clips en affiches"
      }
    }
  ],
  "permissions": [
    "topics"
  ],
  "settings": [
    {
      "key": "channel",
      "type": "text",
      "label": {
        "en": "Twitch channel (login)",
        "fr": "Chaîne Twitch (identifiant)"
      },
      "help": {
        "en": "For example mychannel",
        "fr": "Par exemple machaine"
      }
    },
    {
      "key": "clientId",
      "type": "text",
      "label": {
        "en": "Twitch client id",
        "fr": "Client id Twitch"
      },
      "help": {
        "en": "From dev.twitch.tv/console (an application of your own).",
        "fr": "Depuis dev.twitch.tv/console (une application à vous)."
      }
    },
    {
      "key": "clientSecret",
      "type": "secret",
      "label": {
        "en": "Twitch client secret",
        "fr": "Client secret Twitch"
      }
    }
  ]
}
