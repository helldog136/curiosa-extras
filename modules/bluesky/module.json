{
  "apiVersion": 2,
  "minCore": "0.6.0",
  "id": "bluesky",
  "name": {
    "en": "Bluesky",
    "fr": "Bluesky"
  },
  "version": "1.2.1",
  "platform": "bluesky",
  "description": {
    "en": "Shows your Bluesky button in the site header and shares your follower and post counts.",
    "fr": "Affiche le bouton de votre Bluesky dans l'en-tête et partage vos followers et vos publications."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "🦋",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Bluesky button in the header",
        "fr": "Bouton Bluesky dans l'en-tête"
      }
    },
    {
      "topic": "social.stat",
      "label": {
        "en": "Bluesky followers and posts",
        "fr": "Followers et publications Bluesky"
      }
    }
  ],
  "permissions": [
    "admin"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Statistiques",
        "en": "Statistics"
      }
    }
  ],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://bsky.app/profile/name.bsky.social",
        "fr": "https://bsky.app/profile/nom.bsky.social"
      }
    },
    {
      "key": "trackStats",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Follow my statistics",
        "fr": "Suivre mes statistiques"
      },
      "help": {
        "en": "Counts your followers and posts for the site's statistics. These numbers are public: nothing to set up.",
        "fr": "Compte vos followers et vos publications pour les statistiques du site. Ces chiffres sont publics : rien à régler."
      }
    }
  ],
  "social": {
    "name": "Bluesky",
    "icon": "bluesky",
    "hosts": [
      "bsky.app"
    ],
    "template": "https://bsky.app/profile/{h}",
    "example": {
      "en": "https://bsky.app/profile/name.bsky.social",
      "fr": "https://bsky.app/profile/nom.bsky.social"
    },
    "shapes": [
      {
        "re": "^/profile/([A-Za-z0-9._:-]{1,100})/?$",
        "handle": true
      }
    ]
  }
}
