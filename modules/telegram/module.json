{
  "apiVersion": 2,
  "id": "telegram",
  "name": {
    "en": "Telegram",
    "fr": "Telegram"
  },
  "version": "1.1.1",
  "platform": "telegram",
  "description": {
    "en": "Shows your Telegram button in the site header.",
    "fr": "Affiche le bouton de votre Telegram dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "✈️",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Telegram button in the header",
        "fr": "Bouton Telegram dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://t.me/myname",
        "fr": "https://t.me/monpseudo"
      }
    }
  ],
  "minCore": "0.6.0",
  "social": {
    "name": "Telegram",
    "icon": "telegram",
    "hosts": [
      "t.me",
      "telegram.me"
    ],
    "template": "https://t.me/{h}",
    "example": {
      "en": "https://t.me/myname",
      "fr": "https://t.me/monpseudo"
    },
    "shapes": [
      {
        "re": "^/@?(?!(?:s|joinchat|share|addstickers|proxy|login)(?:/|$))([A-Za-z0-9_]{1,32})/?$",
        "handle": true
      }
    ]
  }
}
