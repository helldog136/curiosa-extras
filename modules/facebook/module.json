{
  "apiVersion": 2,
  "id": "facebook",
  "name": {
    "en": "Facebook",
    "fr": "Facebook"
  },
  "version": "1.1.1",
  "platform": "facebook",
  "description": {
    "en": "Shows your Facebook button in the site header.",
    "fr": "Affiche le bouton de votre Facebook dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "👥",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Facebook button in the header",
        "fr": "Bouton Facebook dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://www.facebook.com/myname",
        "fr": "https://www.facebook.com/monpseudo"
      }
    }
  ],
  "minCore": "0.6.0",
  "social": {
    "name": "Facebook",
    "icon": "facebook",
    "hosts": [
      "facebook.com"
    ],
    "template": "https://www.facebook.com/{h}",
    "example": {
      "en": "https://www.facebook.com/myname",
      "fr": "https://www.facebook.com/monpseudo"
    },
    "aliases": [
      [
        "fb.me",
        "www.facebook.com"
      ],
      [
        "fb.com",
        "www.facebook.com"
      ]
    ],
    "shapes": [
      {
        "re": "^/@?(?!(?:profile\\.php|people|pages|groups|watch|share|p|events|marketplace|gaming|stories|reel|photo|photos|public|login|help|policies)(?:/|$))([A-Za-z0-9.-]{1,60})/?$",
        "handle": true
      }
    ]
  }
}
