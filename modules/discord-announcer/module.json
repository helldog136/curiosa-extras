{
  "apiVersion": 2,
  "id": "discord-announcer",
  "name": {
    "en": "Discord announcements",
    "fr": "Annonces Discord"
  },
  "version": "1.2.0",
  "platform": "discord",
  "description": {
    "en": "Announces your new content on a Discord channel, with no bot or account to link. Also tells it when you go live.",
    "fr": "Annonce vos nouveautés sur un salon Discord, sans bot ni compte à lier. Prévient aussi quand vous passez en direct."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "📣",
  "main": "index.mjs",
  "type": "utility",
  "instances": "single",
  "page": false,
  "consumes": [
    {
      "topic": "core.entry",
      "label": {
        "en": "Published entries (blog, promo codes…)",
        "fr": "Entrées publiées (blog, codes promo…)"
      },
      "tags": true
    },
    {
      "topic": "feed.item",
      "label": {
        "en": "Items offered to the RSS feed by other modules",
        "fr": "Éléments proposés au flux RSS par d'autres modules"
      },
      "tags": false,
      "schema": [
        {
          "key": "id",
          "type": "string"
        },
        {
          "key": "title",
          "type": "string",
          "required": true
        },
        {
          "key": "url",
          "type": "url",
          "required": true
        },
        {
          "key": "summary",
          "type": "string"
        },
        {
          "key": "publishedAt",
          "type": "string"
        },
        {
          "key": "topics",
          "type": "string[]"
        }
      ]
    },
    {
      "topic": "stream.live",
      "label": {
        "en": "Your live stream (Twitch…)",
        "fr": "Votre live (Twitch…)"
      },
      "tags": false,
      "schema": [
        {
          "key": "id",
          "type": "string",
          "required": true
        },
        {
          "key": "title",
          "type": "string",
          "required": true
        },
        {
          "key": "url",
          "type": "url",
          "required": true
        },
        {
          "key": "startedAt",
          "type": "string"
        },
        {
          "key": "game",
          "type": "string"
        }
      ]
    }
  ],
  "permissions": [
    "admin",
    "storage",
    "topics"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Annonces",
        "en": "Announcements"
      }
    }
  ],
  "settings": [
    {
      "key": "webhookUrl",
      "type": "secret",
      "label": {
        "en": "Discord channel sending address",
        "fr": "Adresse d'envoi du salon Discord"
      },
      "help": {
        "en": "In Discord: channel settings, Integrations, then create a sending address. It stays secret and is never shown again.",
        "fr": "Dans Discord : réglages du salon, Intégrations, puis création d'une adresse d'envoi. Elle reste secrète et n'est jamais réaffichée."
      },
      "example": {
        "en": "https://discord.com/…/your-code",
        "fr": "https://discord.com/…/votre-code"
      }
    },
    {
      "key": "mention",
      "type": "text",
      "default": "",
      "label": {
        "en": "Mention",
        "fr": "Mention"
      },
      "help": {
        "en": "Leave empty to notify nobody.",
        "fr": "Laissez vide pour ne prévenir personne."
      },
      "optional": true,
      "example": {
        "en": "@everyone",
        "fr": "@everyone"
      },
      "rare": true
    },
    {
      "key": "prefix",
      "type": "text",
      "default": "📰",
      "label": {
        "en": "Icon before each announcement",
        "fr": "Icône avant chaque annonce"
      },
      "help": {
        "en": "One symbol. Leave empty for none.",
        "fr": "Un seul symbole. Laissez vide pour n'en mettre aucun."
      },
      "example": {
        "en": "📰",
        "fr": "📰"
      },
      "rare": true
    },
    {
      "key": "youtubeLive",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Announce my YouTube lives too",
        "fr": "Annoncer aussi mes directs YouTube"
      },
      "help": {
        "en": "Needs the YouTube channel module. One message per live.",
        "fr": "Demande le module Chaîne YouTube. Un message par direct."
      }
    },
    {
      "key": "liveBoth",
      "type": "select",
      "default": "both",
      "label": {
        "en": "Live on Twitch and YouTube at once",
        "fr": "Direct sur Twitch et YouTube en même temps"
      },
      "help": {
        "en": "Either way, only one message is sent.",
        "fr": "Dans les deux cas, un seul message part."
      },
      "options": [
        {
          "value": "both",
          "label": {
            "en": "One message that mentions both",
            "fr": "Un message qui cite les deux"
          }
        },
        {
          "value": "first",
          "label": {
            "en": "One message, for the first platform seen",
            "fr": "Un message, pour la première plateforme vue"
          }
        }
      ],
      "rare": true
    },
    {
      "key": "liveText",
      "type": "text",
      "default": "",
      "optional": true,
      "label": {
        "en": "Live announcement text",
        "fr": "Texte de l'annonce de direct"
      },
      "help": {
        "en": "Leave empty for the usual sentence. To insert: {platform} (Twitch, YouTube or both), {title}, {game} and {url}. Without {url}, the links are added at the end.",
        "fr": "Laissez vide pour la phrase habituelle. À insérer : {platform} (Twitch, YouTube ou les deux), {title}, {game} et {url}. Sans {url}, les liens sont ajoutés à la fin."
      },
      "example": {
        "en": "Come and watch {title} on {platform}",
        "fr": "Venez voir {title} sur {platform}"
      },
      "advanced": true
    },
    {
      "key": "freshHours",
      "type": "number",
      "default": 24,
      "advanced": true,
      "label": {
        "en": "Only announce recent content",
        "fr": "N'annoncer que le contenu récent"
      },
      "help": {
        "en": "Older content is marked as seen, not announced.",
        "fr": "Le contenu plus ancien est noté comme vu, sans être annoncé."
      },
      "min": 1,
      "max": 720,
      "unit": {
        "en": "hours",
        "fr": "heures"
      }
    },
    {
      "key": "liveCooldownHours",
      "type": "number",
      "default": 2,
      "advanced": true,
      "label": {
        "en": "Time between two live announcements",
        "fr": "Délai entre deux annonces de direct"
      },
      "help": {
        "en": "Two lives closer than this count as the same one.",
        "fr": "Deux directs plus proches que cela comptent pour le même."
      },
      "min": 1,
      "max": 48,
      "unit": {
        "en": "hours",
        "fr": "heures"
      }
    },
    {
      "key": "youtubeCheckMinutes",
      "type": "number",
      "default": 10,
      "advanced": true,
      "label": {
        "en": "Time between two YouTube checks",
        "fr": "Délai entre deux vérifications YouTube"
      },
      "help": {
        "en": "Every 10 minutes is under 3 % of the daily limit.",
        "fr": "Toutes les 10 minutes, c'est moins de 3 % de la limite du jour."
      },
      "min": 5,
      "max": 60,
      "unit": {
        "en": "minutes",
        "fr": "minutes"
      }
    }
  ],
  "minCore": "0.6.0",
  "requires": [
    {
      "service": "youtube.live",
      "optional": true,
      "label": {
        "en": "Announce your YouTube lives (YouTube channel)",
        "fr": "Annoncer vos directs YouTube (Chaîne YouTube)"
      }
    }
  ]
}
