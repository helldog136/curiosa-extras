{
  "apiVersion": 2,
  "id": "x-twitter",
  "name": {
    "en": "X (Twitter)",
    "fr": "X (Twitter)"
  },
  "version": "1.1.1",
  "platform": "x",
  "description": {
    "en": "Shows your X button in the site header.",
    "fr": "Affiche le bouton de votre X dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "🐦",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "X (Twitter) button in the header",
        "fr": "Bouton X (Twitter) dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://x.com/myname",
        "fr": "https://x.com/monpseudo"
      }
    }
  ],
  "minCore": "0.6.0",
  "social": {
    "name": "X",
    "icon": "x",
    "hosts": [
      "x.com"
    ],
    "template": "https://x.com/{h}",
    "example": {
      "en": "https://x.com/myname",
      "fr": "https://x.com/monpseudo"
    },
    "aliases": [
      [
        "twitter.com",
        "x.com"
      ]
    ],
    "shapes": [
      {
        "re": "^/@?(?!(?:home|explore|i|search|intent|share|hashtag|messages|notifications|settings|compose)(?:/|$))([A-Za-z0-9_]{1,15})/?$",
        "handle": true
      }
    ]
  }
}
