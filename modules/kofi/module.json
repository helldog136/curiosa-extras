{
  "apiVersion": 2,
  "id": "kofi",
  "name": {
    "en": "Ko-fi",
    "fr": "Ko-fi"
  },
  "version": "1.1.1",
  "platform": "ko-fi",
  "description": {
    "en": "Shows your Ko-fi button in the site header.",
    "fr": "Affiche le bouton de votre Ko-fi dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "☕",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Ko-fi button in the header",
        "fr": "Bouton Ko-fi dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://ko-fi.com/myname",
        "fr": "https://ko-fi.com/monpseudo"
      }
    }
  ],
  "minCore": "0.6.0",
  "social": {
    "name": "Ko-fi",
    "icon": "kofi",
    "hosts": [
      "ko-fi.com"
    ],
    "template": "https://ko-fi.com/{h}",
    "example": {
      "en": "https://ko-fi.com/myname",
      "fr": "https://ko-fi.com/monpseudo"
    },
    "shapes": [
      {
        "re": "^/@?(?!(?:s|home|explore|account|gold)(?:/|$))([A-Za-z0-9._-]{1,60})/?$",
        "handle": true
      }
    ]
  }
}
