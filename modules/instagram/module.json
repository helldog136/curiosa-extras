{
  "apiVersion": 2,
  "id": "instagram",
  "name": {
    "en": "Instagram",
    "fr": "Instagram"
  },
  "version": "1.1.1",
  "platform": "instagram",
  "description": {
    "en": "Shows your Instagram button in the site header.",
    "fr": "Affiche le bouton de votre Instagram dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "📸",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Instagram button in the header",
        "fr": "Bouton Instagram dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://www.instagram.com/myname",
        "fr": "https://www.instagram.com/monpseudo"
      }
    }
  ],
  "minCore": "0.6.0",
  "social": {
    "name": "Instagram",
    "icon": "instagram",
    "hosts": [
      "instagram.com"
    ],
    "template": "https://www.instagram.com/{h}/",
    "example": {
      "en": "https://www.instagram.com/myname",
      "fr": "https://www.instagram.com/monpseudo"
    },
    "shapes": [
      {
        "re": "^/@?(?!(?:p|reel|reels|stories|explore|accounts|direct|tv)(?:/|$))([A-Za-z0-9._]{1,30})/?$",
        "handle": true
      }
    ]
  }
}
