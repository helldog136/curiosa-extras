{
  "apiVersion": 2,
  "minCore": "0.6.0",
  "id": "mastodon",
  "name": {
    "en": "Mastodon",
    "fr": "Mastodon"
  },
  "version": "1.2.0",
  "platform": "mastodon",
  "description": {
    "en": "Shows your Mastodon button in the site header and shares your follower and post counts.",
    "fr": "Affiche le bouton de votre Mastodon dans l'en-tête et partage vos followers et vos publications."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "🐘",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Mastodon button in the header",
        "fr": "Bouton Mastodon dans l'en-tête"
      }
    },
    {
      "topic": "social.stat",
      "label": {
        "en": "Mastodon followers and posts",
        "fr": "Followers et publications Mastodon"
      }
    }
  ],
  "permissions": [
    "admin"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Statistiques",
        "en": "Statistics"
      }
    }
  ],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste your profile link, or @name@server.",
        "fr": "Collez le lien de votre profil, ou @nom@serveur."
      },
      "example": {
        "en": "https://mastodon.social/@name",
        "fr": "https://mastodon.social/@nom"
      }
    },
    {
      "key": "trackStats",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Follow my statistics",
        "fr": "Suivre mes statistiques"
      },
      "help": {
        "en": "Counts your followers and posts for the site's statistics. These numbers are public: nothing to set up.",
        "fr": "Compte vos followers et vos publications pour les statistiques du site. Ces chiffres sont publics : rien à régler."
      }
    }
  ]
}
