{
  "apiVersion": 2,
  "id": "snapchat",
  "name": {
    "en": "Snapchat",
    "fr": "Snapchat"
  },
  "version": "1.1.1",
  "platform": "snapchat",
  "description": {
    "en": "Shows your Snapchat button in the site header.",
    "fr": "Affiche le bouton de votre Snapchat dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "👻",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Snapchat button in the header",
        "fr": "Bouton Snapchat dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://www.snapchat.com/add/myname",
        "fr": "https://www.snapchat.com/add/monpseudo"
      }
    }
  ],
  "minCore": "0.6.0",
  "social": {
    "name": "Snapchat",
    "icon": "snapchat",
    "hosts": [
      "snapchat.com"
    ],
    "template": "https://www.snapchat.com/add/{h}",
    "example": {
      "en": "https://www.snapchat.com/add/myname",
      "fr": "https://www.snapchat.com/add/monpseudo"
    },
    "shapes": [
      {
        "re": "^/add/([A-Za-z0-9._-]{1,60})/?$",
        "handle": true
      },
      {
        "re": "^/@([A-Za-z0-9._-]{1,60})/?$",
        "handle": true
      }
    ]
  }
}
