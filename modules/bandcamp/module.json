{
  "apiVersion": 2,
  "id": "bandcamp",
  "name": {
    "en": "Bandcamp",
    "fr": "Bandcamp"
  },
  "version": "1.1.1",
  "platform": "bandcamp",
  "description": {
    "en": "Shows your Bandcamp button in the site header.",
    "fr": "Affiche le bouton de votre Bandcamp dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "🎶",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Bandcamp button in the header",
        "fr": "Bouton Bandcamp dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://myname.bandcamp.com",
        "fr": "https://monnom.bandcamp.com"
      }
    }
  ],
  "minCore": "0.6.0",
  "social": {
    "name": "Bandcamp",
    "icon": "bandcamp",
    "hosts": [
      "bandcamp.com"
    ],
    "template": "https://{h}.bandcamp.com",
    "example": {
      "en": "https://myname.bandcamp.com",
      "fr": "https://monnom.bandcamp.com"
    },
    "handle": "^@?[A-Za-z0-9-]{1,60}$",
    "shapes": [
      {
        "host": "^([a-z0-9-]+)\\.bandcamp\\.com$",
        "fromHost": true,
        "re": "^/?$",
        "handle": true
      }
    ]
  }
}
