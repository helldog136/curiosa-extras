    },
    {
      "key": "resultsDefault",
      "type": "select",
      "default": "always",
      "label": {
        "fr": "Résultats pour les nouveaux sondages",
        "en": "Results for new polls"
      },
      "help": {
        "fr": "Vous pouvez toujours changer ce choix sondage par sondage.",
        "en": "You can still change it poll by poll."
      },
      "options": [
        {
          "value": "always",
          "label": {
            "fr": "Visibles tout de suite",
            "en": "Visible right away"
          }
        },
        {
          "value": "after",
          "label": {
            "fr": "Visibles après le vote",
            "en": "Visible after voting"
          }
        }
      ]
    },
    {
      "key": "retentionDays",
      "type": "number",
      "default": 30,
      "advanced": true,
      "label": {
        "fr": "Jours de conservation des bulletins après la fin",
        "en": "Days to keep ballots after the end"
      },
      "help": {
        "fr": "De 1 à 90. Ensuite, seuls les totaux restent.",
        "en": "From 1 to 90. After that only the totals remain."
      }
    },
    {
      "key": "ratePerHour",
      "type": "number",
      "default": 30,
      "advanced": true,
      "label": {
        "fr": "Votes par heure et par connexion",
        "en": "Votes per hour and connection"
      },
      "help": {
        "fr": "De 3 à 300. Une classe ou un salon partageant la même connexion en a parfois besoin de plus.",
        "en": "From 3 to 300. A class or an event sharing one connection may need more."
      }
    },
    {
      "key": "obsRefreshSeconds",
      "type": "number",
      "default": 5,
      "advanced": true,
      "label": {
        "fr": "Secondes entre deux mises à jour à l'écran",
        "en": "Seconds between two on-screen updates"
      },
      "help": {
        "fr": "De 3 à 30. L'écran ralentit tout seul quand rien ne change.",
        "en": "From 3 to 30. The screen slows down by itself when nothing changes."
      }
    },
    {
      "key": "obsPosition",
      "type": "select",
      "group": "appearance",
      "default": "left",
      "label": {
        "fr": "Place à l'écran",
        "en": "Position on screen"
      },
      "options": [
        {
          "value": "left",
          "label": {
            "fr": "En bas à gauche",
            "en": "Bottom left"
          }
        },
        {
          "value": "center",
          "label": {
            "fr": "En bas au centre",
            "en": "Bottom centre"
          }
        },
        {
          "value": "right",
          "label": {
            "fr": "En bas à droite",
            "en": "Bottom right"
          }
        }
      ]
    },
    {
      "key": "obsAccent",
      "type": "color",
      "group": "appearance",
      "default": "theme:accent",
      "label": {
        "fr": "Couleur des barres à l'écran",
        "en": "Bar colour on screen"
      }
    },
    {
      "key": "obsText",
      "type": "color",
      "group": "appearance",
      "default": "theme:fg",
      "label": {
        "fr": "Couleur du texte à l'écran",
        "en": "Text colour on screen"
      }
    },
    {
      "key": "obsCard",
      "type": "color",
      "group": "appearance",
      "default": "theme:surface",
      "label": {
        "fr": "Couleur du fond à l'écran",
        "en": "Background colour on screen"
      }
    }
  ],
  "mcp": [
    {
      "name": "polls_list",
      "readOnly": true,
      "description": "List the polls kept on the site, newest first, with their state (open or closed), number of voters and public link.",
      "input": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ],
            "description": "Only open or only closed polls."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "How many at most (default 20)."
          }
        }
      }
    },
    {
      "name": "poll_results",
      "readOnly": true,
      "description": "Read the current results of one poll: votes and percentage for each choice. Percentages are shares of voters (they can add up to more than 100 when several choices are allowed).",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "description": "Poll id (from polls_list) or its address name."
          }
        }
      }
    },
    {
      "name": "poll_create",
      "description": "Create and open a new poll (2 to 8 different choices). Visitors can vote right away at the returned link.",
      "input": {
        "type": "object",
        "required": [
          "question",
          "choices"
        ],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 140,
            "description": "The question."
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "2 to 8 different choices, 60 characters each at most."
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "description": "How many choices one person may tick (1 = single choice, default)."
          },
          "resultsMode": {
            "type": "string",
            "enum": [
              "always",
              "after"
            ],
            "description": "always = results visible right away; after = visible only after voting."
          },
          "endsAt": {
            "type": "string",
            "maxLength": 40,
            "description": "Optional end, ISO 8601 with offset, e.g. 2026-11-03T20:00:00+01:00. Must be in the future, within a year."
          }
        }
      }
    },
    {
      "name": "poll_close",
      "description": "Close an open poll now. Nobody can vote any more and the final result is shown.",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "description": "Poll id (from polls_list)."
          }
        }
      }
    }
  ]
}
