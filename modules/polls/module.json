{
  "apiVersion": 2,
  "id": "polls",
  "name": {
    "en": "Polls",
    "fr": "Sondages"
  },
  "version": "1.0.0",
  "minCore": "0.2.5",
  "description": {
    "en": "Ask your audience a question: 2 to 8 choices, one vote per person with no account, an end date, live results as clear bars, a page to share and a live view for your stream (OBS).",
    "fr": "Posez une question à votre communauté : 2 à 8 choix, un vote par personne sans compte, une date de fin, des résultats en barres claires, une page à partager et un affichage en direct pour votre stream (OBS)."
  },
  "author": "Helldog136",
  "license": "Curiosa License 1.0",
  "icon": "📊",
  "main": "index.mjs",
  "type": "widget",
  "instances": "single",
  "page": true,
  "basePath": "polls",
  "privacy": {
    "en": "No account needed. Your browser keeps a random private code (local storage, not a cookie) so you cannot vote twice; the site keeps only a scrambled version, different for each poll, and your ticked choices. Your IP address is never saved: it only serves, scrambled with a daily salt never written to disk, to slow down abuse. Votes carry no name; scrambled codes are erased 30 days after a poll ends. Clearing browser data removes your code. To remove a poll, write to the site's contact.",
    "fr": "Aucun compte. Votre navigateur garde un code privé au hasard (stockage local, pas un cookie) pour qu'on ne vote pas deux fois ; le site n'en garde qu'une version brouillée, propre à chaque sondage, et vos choix. Votre adresse IP n'est jamais enregistrée : brouillée par un sel quotidien jamais écrit sur disque, elle sert seulement à freiner les abus. Aucun nom n'est gardé ; les codes brouillés sont effacés 30 jours après la fin du sondage. Pour retirer un sondage, écrivez au contact du site."
  },
  "permissions": [
    "slots",
    "sections",
    "pages",
    "routes",
    "storage",
    "overlay",
    "admin",
    "mcp"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Mes sondages",
        "en": "My polls"
      }
    },
    {
      "id": "screen",
      "label": {
        "fr": "À l'écran",
        "en": "On screen"
      },
      "panel": true
    }
  ],
  "sections": [
    {
      "id": "current",
      "label": {
        "fr": "Le sondage en cours",
        "en": "The current poll"
      },
      "size": "medium"
    }
  ],
  "rights": [
    {
      "id": "manage",
      "label": {
        "fr": "créer, modifier, fermer et supprimer des sondages",
        "en": "create, edit, close and delete polls"
      },
      "help": {
        "fr": "Permet aussi de choisir le sondage affiché à l'écran et de télécharger les résultats.",
        "en": "Also lets the person pick the poll shown on screen and download the results."
      },
      "default": {
        "admin": true,
        "editor": false
      }
    },
    {
      "id": "obs.view",
      "label": {
        "fr": "voir et changer l'adresse secrète de la source OBS",
        "en": "see and change the secret address of the OBS source"
      },
      "help": {
        "fr": "Cette adresse donne accès aux résultats en direct, même cachés au public.",
        "en": "This address gives access to the live results, even those hidden from the public."
      },
      "sensitive": true,
      "default": {
        "admin": true,
        "editor": false
      }
    }
  ],
  "settings": [
    {
      "key": "intro",
      "type": "textarea",
      "translatable": true,
      "optional": true,
      "label": {
        "fr": "Texte d'introduction de la page (Markdown)",
        "en": "Intro text of the page (Markdown)"
      },
      "help": {
        "fr": "Affiché au-dessus de la liste des sondages. Laissez vide pour ne rien afficher.",
        "en": "Shown above the list of polls. Leave empty to show nothing."
      }
    },
    {
      "key": "timezone",
      "type": "select",
      "default": "Europe/Paris",
      "label": {
        "fr": "Votre fuseau horaire",
        "en": "Your time zone"
      },
      "help": {
        "fr": "Les dates de fin que vous écrivez sont lues dans ce fuseau, et l'heure est toujours écrite avec son fuseau pour vos visiteurs.",
        "en": "End dates you write are read in this time zone, and visitors always see the time written with its zone."
      },
      "options": [
        {
          "value": "Europe/Paris",
          "label": {
            "fr": "Paris, Bruxelles, Genève, Berlin, Madrid",
            "en": "Paris, Brussels, Geneva, Berlin, Madrid"
