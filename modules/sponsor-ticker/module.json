{
  "apiVersion": 2,
  "id": "sponsor-ticker",
  "name": {
    "en": "Sponsor ticker overlay (OBS)",
    "fr": "Overlay sponsors (OBS)"
  },
  "version": "1.2.0",
  "minCore": "0.6.0",
  "description": {
    "en": "A lower-third for OBS that periodically shows one of your sponsors with its promo code and a QR code.",
    "fr": "Un bandeau pour OBS qui affiche périodiquement l'un de vos sponsors avec son code promo et un QR code."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "💬",
  "main": "index.mjs",
  "type": "overlay",
  "instances": "multiple",
  "consumes": [
    {
      "topic": "sponsor.card",
      "label": {
        "en": "Sponsors (from the Sponsors module)",
        "fr": "Sponsors (du module Sponsors)"
      },
      "tags": true,
      "schema": [
        {
          "key": "id",
          "type": "string"
        },
        {
          "key": "name",
          "type": "string",
          "required": true
        },
        {
          "key": "text",
          "type": "string"
        },
        {
          "key": "url",
          "type": "url"
        },
        {
          "key": "code",
          "type": "string"
        },
        {
          "key": "logo",
          "type": "url"
        },
        {
          "key": "publishedAt",
          "type": "string"
        },
        {
          "key": "tags",
          "type": "string[]"
        }
      ]
    },
    {
      "topic": "core.entry",
      "label": {
        "en": "Entries of any promo-code or article list",
        "fr": "Entrées de n'importe quelle liste de codes ou d'articles"
      },
      "tags": true
    }
  ],
  "permissions": [
    "overlay",
    "routes",
    "topics"
  ],
  "settings": [
    {
      "key": "visual",
      "type": "select",
      "default": "neon",
      "label": {
        "en": "Look",
        "fr": "Style"
      },
      "options": [
        {
          "value": "neon",
          "label": {
            "en": "Neon",
            "fr": "Néon"
          }
        },
        {
          "value": "cine",
          "label": {
            "en": "Cinema",
            "fr": "Ciné"
          }
        },
        {
          "value": "broadcast",
          "label": {
            "en": "Broadcast",
            "fr": "Broadcast"
          }
        }
      ],
      "group": "appearance"
    },
    {
      "key": "accentColor",
      "type": "color",
      "default": "theme:accent",
      "label": {
        "en": "Accent color",
        "fr": "Couleur d'accent"
      },
      "group": "appearance"
    },
    {
      "key": "periodSeconds",
      "type": "number",
      "default": 90,
      "label": {
        "en": "Seconds between two appearances",
        "fr": "Secondes entre deux apparitions"
      }
    },
    {
      "key": "holdSeconds",
      "type": "number",
      "default": 10,
      "label": {
        "en": "Seconds on screen",
        "fr": "Secondes à l'écran"
      }
    },
    {
      "key": "showQr",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Show a QR code",
        "fr": "Afficher un QR code"
      }
    },
    {
      "key": "transitionIn",
      "type": "select",
      "default": "auto",
      "rare": true,
      "label": {
        "fr": "Comment il arrive",
        "en": "How it enters"
      },
      "help": {
        "fr": "« Par défaut » garde le style actuel.",
        "en": "\"Default\" keeps the current look."
      },
      "options": [
        {
          "value": "auto",
          "label": {
            "fr": "Par défaut",
            "en": "Default"
          }
        },
        {
          "value": "slide",
          "label": {
            "fr": "Glisse depuis le bord le plus proche",
            "en": "Slide in from the nearest edge"
          }
        },
        {
          "value": "slideLeft",
          "label": {
            "fr": "Glisse depuis la gauche",
            "en": "Slide in from the left"
          }
        },
        {
          "value": "slideRight",
          "label": {
            "fr": "Glisse depuis la droite",
            "en": "Slide in from the right"
          }
        },
        {
          "value": "slideTop",
          "label": {
            "fr": "Glisse depuis le haut",
            "en": "Slide in from the top"
          }
        },
        {
          "value": "slideBottom",
          "label": {
            "fr": "Glisse depuis le bas",
            "en": "Slide in from the bottom"
          }
        },
        {
          "value": "fade",
          "label": {
            "fr": "Apparaît en fondu",
            "en": "Fade in"
          }
        },
        {
          "value": "jiggle",
          "label": {
            "fr": "Arrive avec un rebond",
            "en": "Jiggle in"
          }
        },
        {
          "value": "pop",
          "label": {
            "fr": "Surgit en zoom",
            "en": "Pop in"
          }
        },
        {
          "value": "none",
          "label": {
            "fr": "Instantané",
            "en": "Instant"
          }
        }
      ]
    },
    {
      "key": "transitionOut",
      "type": "select",
      "default": "same",
      "rare": true,
      "label": {
        "fr": "Comment il part",
        "en": "How it leaves"
      },
      "help": {
        "fr": "« Comme l'arrivée » la joue à l'envers.",
        "en": "\"Same\" plays the entrance backwards."
      },
      "options": [
        {
          "value": "same",
          "label": {
            "fr": "Comme l'arrivée",
            "en": "Same as how it enters"
          }
        },
        {
          "value": "slide",
          "label": {
            "fr": "Glisse vers le bord le plus proche",
            "en": "Slide out to the nearest edge"
          }
        },
        {
          "value": "slideLeft",
          "label": {
            "fr": "Glisse vers la gauche",
            "en": "Slide out to the left"
          }
        },
        {
          "value": "slideRight",
          "label": {
            "fr": "Glisse vers la droite",
            "en": "Slide out to the right"
          }
        },
        {
          "value": "slideTop",
          "label": {
            "fr": "Glisse vers le haut",
            "en": "Slide out to the top"
          }
        },
        {
          "value": "slideBottom",
          "label": {
            "fr": "Glisse vers le bas",
            "en": "Slide out to the bottom"
          }
        },
        {
          "value": "fade",
          "label": {
            "fr": "Disparaît en fondu",
            "en": "Fade out"
          }
        },
        {
          "value": "jiggle",
          "label": {
            "fr": "Rebondit, puis s'efface",
            "en": "Jiggle, then fade"
          }
        },
        {
          "value": "pop",
          "label": {
            "fr": "Disparaît en zoom",
            "en": "Pop out"
          }
        },
        {
          "value": "none",
          "label": {
            "fr": "Instantané",
            "en": "Instant"
          }
        }
      ]
    },
    {
      "key": "transitionSeconds",
      "type": "number",
      "default": 0.6,
      "rare": true,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "unit": {
        "fr": "secondes",
        "en": "seconds"
      },
      "label": {
        "fr": "Durée du mouvement",
        "en": "Length of the movement"
      }
    },
    {
      "key": "devMode",
      "type": "boolean",
      "default": false,
      "advanced": true,
      "label": {
        "en": "Developer mode",
        "fr": "Mode développeur"
      },
      "help": {
        "en": "Lets the URL control chance: ?dev=1 (appears after 0.5 s, repeats every 4 s), ?seed=42 (same order every time).",
        "fr": "Permet à l'URL de piloter le hasard : ?dev=1 (apparaît après 0,5 s, se répète toutes les 4 s), ?seed=42 (même ordre à chaque fois)."
      }
    }
  ],
  "overlayElements": [
    {
      "id": "sponsors",
      "label": {
        "fr": "Bandeau sponsors",
        "en": "Sponsor banner"
      },
      "description": {
        "fr": "Un sponsor à la fois, avec son code promo et un QR code, qui apparaît de temps en temps.",
        "en": "One sponsor at a time, with its promo code and a QR code, shown from time to time."
      },
      "fit": "scale",
      "size": {
        "width": 720,
        "height": 180
      },
      "followsStyle": true,
      "demo": true,
      "options": [
        {
          "id": "qr",
          "type": "boolean",
          "label": {
            "fr": "Afficher le QR code",
            "en": "Show the QR code"
          },
          "help": {
            "fr": "Si le QR code est masqué dans les réglages du module, il reste masqué.",
            "en": "If the QR code is hidden in the module settings, it stays hidden."
          },
          "default": true
        },
        {
          "id": "transitionIn",
          "type": "choice",
          "label": {
            "fr": "Comment il arrive",
            "en": "How it enters"
          },
          "choices": [
            {
              "value": "module",
              "label": {
                "fr": "Comme dans les réglages du module",
                "en": "Like the module settings"
              }
            },
            {
              "value": "auto",
              "label": {
                "fr": "Par défaut",
                "en": "Default"
              }
            },
            {
              "value": "slide",
              "label": {
                "fr": "Glisse depuis le bord le plus proche",
                "en": "Slide in from the nearest edge"
              }
            },
            {
              "value": "slideLeft",
              "label": {
                "fr": "Glisse depuis la gauche",
                "en": "Slide in from the left"
              }
            },
            {
              "value": "slideRight",
              "label": {
                "fr": "Glisse depuis la droite",
                "en": "Slide in from the right"
              }
            },
            {
              "value": "slideTop",
              "label": {
                "fr": "Glisse depuis le haut",
                "en": "Slide in from the top"
              }
            },
            {
              "value": "slideBottom",
              "label": {
                "fr": "Glisse depuis le bas",
                "en": "Slide in from the bottom"
              }
            },
            {
              "value": "fade",
              "label": {
                "fr": "Apparaît en fondu",
                "en": "Fade in"
              }
            },
            {
              "value": "jiggle",
              "label": {
                "fr": "Arrive avec un rebond",
                "en": "Jiggle in"
              }
            },
            {
              "value": "pop",
              "label": {
                "fr": "Surgit en zoom",
                "en": "Pop in"
              }
            },
            {
              "value": "none",
              "label": {
                "fr": "Instantané",
                "en": "Instant"
              }
            }
          ],
          "default": "module"
        },
        {
          "id": "transitionOut",
          "type": "choice",
          "label": {
            "fr": "Comment il part",
            "en": "How it leaves"
          },
          "choices": [
            {
              "value": "module",
              "label": {
                "fr": "Comme dans les réglages du module",
                "en": "Like the module settings"
              }
            },
            {
              "value": "same",
              "label": {
                "fr": "Comme l'arrivée",
                "en": "Same as how it enters"
              }
            },
            {
              "value": "slide",
              "label": {
                "fr": "Glisse vers le bord le plus proche",
                "en": "Slide out to the nearest edge"
              }
            },
            {
              "value": "slideLeft",
              "label": {
                "fr": "Glisse vers la gauche",
                "en": "Slide out to the left"
              }
            },
            {
              "value": "slideRight",
              "label": {
                "fr": "Glisse vers la droite",
                "en": "Slide out to the right"
              }
            },
            {
              "value": "slideTop",
              "label": {
                "fr": "Glisse vers le haut",
                "en": "Slide out to the top"
              }
            },
            {
              "value": "slideBottom",
              "label": {
                "fr": "Glisse vers le bas",
                "en": "Slide out to the bottom"
              }
            },
            {
              "value": "fade",
              "label": {
                "fr": "Disparaît en fondu",
                "en": "Fade out"
              }
            },
            {
              "value": "jiggle",
              "label": {
                "fr": "Rebondit, puis s'efface",
                "en": "Jiggle, then fade"
              }
            },
            {
              "value": "pop",
              "label": {
                "fr": "Disparaît en zoom",
                "en": "Pop out"
              }
            },
            {
              "value": "none",
              "label": {
                "fr": "Instantané",
                "en": "Instant"
              }
            }
          ],
          "default": "module"
        }
      ]
    }
  ]
}
