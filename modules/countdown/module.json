  "rights": [
    {
      "id": "events.edit",
      "label": {
        "fr": "créer et modifier les comptes à rebours",
        "en": "create and edit countdowns"
      },
      "help": {
        "fr": "Ajouter un événement, changer sa date, son message de fin, le mettre à la une.",
        "en": "Add an event, change its date or end message, put it first."
      },
      "default": {
        "admin": true,
        "editor": false
      }
    },
    {
      "id": "events.delete",
      "label": {
        "fr": "supprimer des comptes à rebours",
        "en": "delete countdowns"
      },
      "help": {
        "fr": "Retirer un événement pour de bon.",
        "en": "Remove an event for good."
      },
      "default": {
        "admin": true,
        "editor": false
      }
    }
  ],
  "mcp": [
    {
      "name": "events_list",
      "readOnly": true,
      "description": "List the countdown events shown on the site (upcoming first, then those whose time has just passed and that are still shown). With include_hidden=true also the ones already hidden. Each has its exact start in UTC, its time zone, its state and until when it stays visible. Use it to avoid creating a duplicate.",
      "input": {
        "type": "object",
        "properties": {
          "include_hidden": {
            "type": "boolean",
            "description": "Also list events already hidden from the site."
          }
        }
      }
    },
    {
      "name": "event_create",
      "description": "Create a countdown event (a release, a launch, a birthday, a convention - NOT a regular stream, which belongs to the schedule module). Give the day and time as written in the event's own time zone; the module works out the exact moment, including summer/winter time of that day. Returns the created event with its start in UTC.",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Event name, e.g. 'Game launch'.",
            "maxLength": 80
          },
          "date": {
            "type": "string",
            "description": "Day as YYYY-MM-DD, in the event's time zone, e.g. 2026-11-14.",
            "maxLength": 10
          },
          "time": {
            "type": "string",
            "description": "Time of day as HH:MM (24 h), e.g. 21:00. Leave out for an all-day event.",
            "maxLength": 12
          },
          "timezone": {
            "type": "string",
            "description": "Official time zone name of the event, e.g. Europe/Paris, Asia/Tokyo. Empty = the site owner's zone. Daylight saving time of that day is applied for you.",
            "maxLength": 64
          },
          "all_day": {
            "type": "boolean",
            "description": "True for an all-day event (birthday, convention day): no time."
          },
          "end_date": {
            "type": "string",
            "description": "Last day as YYYY-MM-DD (optional).",
            "maxLength": 10
          },
          "end_time": {
            "type": "string",
            "description": "End time as HH:MM (optional, same time zone).",
            "maxLength": 12
          },
          "description": {
            "type": "string",
            "description": "Short text shown on the event page and in the calendar file.",
            "maxLength": 600
          },
          "location": {
            "type": "string",
            "description": "Place or platform, e.g. 'Twitch'.",
            "maxLength": 120
          },
          "end_message": {
            "type": "string",
            "description": "Message shown once the time has come, e.g. 'It is on!'.",
            "maxLength": 140
          },
          "end_link_label": {
            "type": "string",
            "description": "Label of the button shown with the end message.",
            "maxLength": 40
          },
          "end_link": {
            "type": "string",
            "description": "Address (https://...) of the button shown with the end message.",
            "maxLength": 500
          },
          "keep": {
            "type": "string",
            "enum": [
              "1h",
              "6h",
              "1d",
              "3d",
              "7d",
              "30d",
              "never"
            ],
            "description": "How long the event stays shown after it has started. Empty = the site default."
          },
          "featured": {
            "type": "boolean",
            "description": "True to put this event first on the home page (only one at a time)."
          }
        },
        "required": [
          "title",
          "date"
        ]
      }
    },
    {
      "name": "event_update",
      "description": "Change an existing countdown event. Only the fields you give are changed. Returns the updated event.",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Event name, e.g. 'Game launch'.",
            "maxLength": 80
          },
          "date": {
            "type": "string",
            "description": "Day as YYYY-MM-DD, in the event's time zone, e.g. 2026-11-14.",
            "maxLength": 10
          },
          "time": {
            "type": "string",
            "description": "Time of day as HH:MM (24 h), e.g. 21:00. Leave out for an all-day event.",
            "maxLength": 12
          },
          "timezone": {
            "type": "string",
            "description": "Official time zone name of the event, e.g. Europe/Paris, Asia/Tokyo. Empty = the site owner's zone. Daylight saving time of that day is applied for you.",
            "maxLength": 64
