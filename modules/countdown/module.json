{
  "apiVersion": 2,
  "id": "countdown",
  "name": {
    "fr": "Compte à rebours",
    "en": "Countdown"
  },
  "version": "1.0.0",
  "minCore": "0.2.5",
  "description": {
    "fr": "Annoncez une sortie, un lancement, un anniversaire ou une convention : vos visiteurs voient le temps qui reste et l'heure chez eux, et peuvent l'ajouter à leur agenda. Une page, un morceau d'accueil et une source pour OBS.",
    "en": "Announce a release, a launch, a birthday or a convention: visitors see the time left and the time where they live, and can add it to their calendar. A page, a home section and an OBS source."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "⏳",
  "main": "index.mjs",
  "type": "widget",
  "instances": "multiple",
  "page": true,
  "basePath": "countdown",
  "permissions": [
    "slots",
    "sections",
    "pages",
    "routes",
    "storage",
    "overlay",
    "mcp",
    "admin"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Mes événements",
        "en": "My events"
      }
    }
  ],
