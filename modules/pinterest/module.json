{
  "apiVersion": 2,
  "id": "pinterest",
  "name": {
    "en": "Pinterest",
    "fr": "Pinterest"
  },
  "version": "1.1.1",
  "platform": "pinterest",
  "description": {
    "en": "Shows your Pinterest button in the site header.",
    "fr": "Affiche le bouton de votre Pinterest dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "📌",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Pinterest button in the header",
        "fr": "Bouton Pinterest dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://www.pinterest.com/myname",
        "fr": "https://www.pinterest.com/monpseudo"
      }
    }
  ],
  "minCore": "0.6.0",
  "social": {
    "name": "Pinterest",
    "icon": "pinterest",
    "hosts": [
      "pinterest.com"
    ],
    "template": "https://www.pinterest.com/{h}/",
    "example": {
      "en": "https://www.pinterest.com/myname",
      "fr": "https://www.pinterest.com/monpseudo"
    },
    "shapes": [
      {
        "re": "^/@?(?!(?:pin|ideas|search|today|business|login)(?:/|$))([A-Za-z0-9._-]{1,60})/?$",
        "handle": true
      }
    ]
  }
}
