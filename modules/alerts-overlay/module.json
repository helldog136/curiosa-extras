{
  "apiVersion": 2,
  "id": "alerts-overlay",
  "name": {
    "en": "Alerts overlay (OBS)",
    "fr": "Overlay alertes (OBS)"
  },
  "version": "1.3.0",
  "minCore": "0.6.0",
  "description": {
    "en": "A pop-up for OBS that shows your alerts (new follower, sub, raid…), sent by your stream tools or by YouTube.",
    "fr": "Une fenêtre pour OBS qui affiche vos alertes (follow, sub, raid…), envoyées par vos outils de stream ou YouTube."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "🔔",
  "main": "index.mjs",
  "type": "overlay",
  "instances": "multiple",
  "permissions": [
    "overlay",
    "routes",
    "topics",
    "admin"
  ],
  "settings": [
    {
      "key": "pushToken",
      "type": "secret",
      "advanced": true,
      "label": {
        "en": "Sending code",
        "fr": "Code d'envoi"
      },
      "help": {
        "en": "Whatever sends alerts must present it: Authorization: Bearer <token>. Without a token, nothing can push (except the test button).",
        "fr": "Ce qui envoie les alertes doit le présenter : Authorization: Bearer <jeton>. Sans jeton, rien ne peut pousser (sauf le bouton de test)."
      }
    },
    {
      "key": "youtubeText",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Show the text of YouTube messages",
        "fr": "Afficher le texte des messages YouTube"
      },
      "help": {
        "en": "A Super Chat message can contain anything your viewers write. Unticked (recommended), only the name and the amount are shown. Ticked, the text is shown too, cut to 140 characters, always as plain text.",
        "fr": "Le message d'un Super Chat peut contenir tout ce qu'écrit votre public. Décoché (recommandé), seuls le pseudo et le montant s'affichent. Coché, le texte s'affiche aussi, coupé à 140 caractères, toujours en texte brut."
      }
    },
    {
      "key": "visual",
      "type": "select",
      "default": "neon",
      "group": "appearance",
      "label": {
        "en": "Look",
        "fr": "Style"
      },
      "options": [
        {
          "value": "neon",
          "label": {
            "en": "Neon",
            "fr": "Néon"
          }
        },
        {
          "value": "plain",
          "label": {
            "en": "Plain",
            "fr": "Sobre"
          }
        }
      ]
    },
    {
      "key": "accentColor",
      "type": "color",
      "default": "theme:accent",
      "group": "appearance",
      "label": {
        "en": "Accent color",
        "fr": "Couleur d'accent"
      }
    },
    {
      "key": "durationSeconds",
      "type": "number",
      "default": 6,
      "label": {
        "en": "Seconds on screen",
        "fr": "Secondes à l'écran"
      }
    },
    {
      "key": "transitionIn",
      "type": "select",
      "default": "auto",
      "rare": true,
      "label": {
        "fr": "Comment il arrive",
        "en": "How it enters"
      },
      "help": {
        "fr": "« Par défaut » garde le style actuel.",
        "en": "\"Default\" keeps the current look."
      },
      "options": [
        {
          "value": "auto",
          "label": {
            "fr": "Par défaut",
            "en": "Default"
          }
        },
        {
          "value": "slide",
          "label": {
            "fr": "Glisse depuis le bord le plus proche",
            "en": "Slide in from the nearest edge"
          }
        },
        {
          "value": "slideLeft",
          "label": {
            "fr": "Glisse depuis la gauche",
            "en": "Slide in from the left"
          }
        },
        {
          "value": "slideRight",
          "label": {
            "fr": "Glisse depuis la droite",
            "en": "Slide in from the right"
          }
        },
        {
          "value": "slideTop",
          "label": {
            "fr": "Glisse depuis le haut",
            "en": "Slide in from the top"
          }
        },
        {
          "value": "slideBottom",
          "label": {
            "fr": "Glisse depuis le bas",
            "en": "Slide in from the bottom"
          }
        },
        {
          "value": "fade",
          "label": {
            "fr": "Apparaît en fondu",
            "en": "Fade in"
          }
        },
        {
          "value": "jiggle",
          "label": {
            "fr": "Arrive avec un rebond",
            "en": "Jiggle in"
          }
        },
        {
          "value": "pop",
          "label": {
            "fr": "Surgit en zoom",
            "en": "Pop in"
          }
        },
        {
          "value": "none",
          "label": {
            "fr": "Instantané",
            "en": "Instant"
          }
        }
      ]
    },
    {
      "key": "transitionOut",
      "type": "select",
      "default": "same",
      "rare": true,
      "label": {
        "fr": "Comment il part",
        "en": "How it leaves"
      },
      "help": {
        "fr": "« Comme l'arrivée » la joue à l'envers.",
        "en": "\"Same\" plays the entrance backwards."
      },
      "options": [
        {
          "value": "same",
          "label": {
            "fr": "Comme l'arrivée",
            "en": "Same as how it enters"
          }
        },
        {
          "value": "slide",
          "label": {
            "fr": "Glisse vers le bord le plus proche",
            "en": "Slide out to the nearest edge"
          }
        },
        {
          "value": "slideLeft",
          "label": {
            "fr": "Glisse vers la gauche",
            "en": "Slide out to the left"
          }
        },
        {
          "value": "slideRight",
          "label": {
            "fr": "Glisse vers la droite",
            "en": "Slide out to the right"
          }
        },
        {
          "value": "slideTop",
          "label": {
            "fr": "Glisse vers le haut",
            "en": "Slide out to the top"
          }
        },
        {
          "value": "slideBottom",
          "label": {
            "fr": "Glisse vers le bas",
            "en": "Slide out to the bottom"
          }
        },
        {
          "value": "fade",
          "label": {
            "fr": "Disparaît en fondu",
            "en": "Fade out"
          }
        },
        {
          "value": "jiggle",
          "label": {
            "fr": "Rebondit, puis s'efface",
            "en": "Jiggle, then fade"
          }
        },
        {
          "value": "pop",
          "label": {
            "fr": "Disparaît en zoom",
            "en": "Pop out"
          }
        },
        {
          "value": "none",
          "label": {
            "fr": "Instantané",
            "en": "Instant"
          }
        }
      ]
    },
    {
      "key": "transitionSeconds",
      "type": "number",
      "default": 0.5,
      "rare": true,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "unit": {
        "fr": "secondes",
        "en": "seconds"
      },
      "label": {
        "fr": "Durée du mouvement",
        "en": "Length of the movement"
      }
    }
  ],
  "consumes": [
    {
      "topic": "live.event",
      "label": {
        "en": "Donations and memberships on your live (YouTube…)",
        "fr": "Dons et adhésions de votre direct (YouTube…)"
      },
      "schema": [
        {
          "key": "id",
          "type": "string",
          "required": true
        },
        {
          "key": "kind",
          "type": "string",
          "required": true
        },
        {
          "key": "platform",
          "type": "string"
        },
        {
          "key": "who",
          "type": "string"
        },
        {
          "key": "at",
          "type": "string",
          "required": true
        },
        {
          "key": "amount",
          "type": "number"
        },
        {
          "key": "currency",
          "type": "string"
        },
        {
          "key": "count",
          "type": "number"
        },
        {
          "key": "text",
          "type": "string"
        }
      ]
    }
  ],
  "overlayElements": [
    {
      "id": "alerts",
      "label": {
        "en": "Alerts",
        "fr": "Alertes"
      },
      "description": {
        "en": "The pop-up that shows each alert (follow, sub, raid, live donations) the moment it arrives.",
        "fr": "La fenêtre qui affiche chaque alerte (follow, sub, raid, dons du direct) au moment où elle arrive."
      },
      "fit": "scale",
      "size": {
        "width": 640,
        "height": 260
      },
      "followsStyle": true,
      "demo": true,
      "options": [
        {
          "id": "kinds",
          "type": "choice",
          "label": {
            "en": "Alerts shown",
            "fr": "Alertes affichées"
          },
          "help": {
            "en": "Use two elements to show channel alerts and live donations in two places.",
            "fr": "Utilisez deux éléments pour montrer les alertes de la chaîne et les dons du direct à deux endroits."
          },
          "choices": [
            {
              "value": "all",
              "label": {
                "en": "All alerts",
                "fr": "Toutes les alertes"
              }
            },
            {
              "value": "channel",
              "label": {
                "en": "Channel alerts (follow, sub, raid)",
                "fr": "Alertes de la chaîne (follow, sub, raid)"
              }
            },
            {
              "value": "live",
              "label": {
                "en": "Live donations and memberships",
                "fr": "Dons et adhésions du direct"
              }
            }
          ],
          "default": "all"
        },
        {
          "id": "transitionIn",
          "type": "choice",
          "label": {
            "fr": "Comment il arrive",
            "en": "How it enters"
          },
          "choices": [
            {
              "value": "module",
              "label": {
                "fr": "Comme dans les réglages du module",
                "en": "Like the module settings"
              }
            },
            {
              "value": "auto",
              "label": {
                "fr": "Par défaut",
                "en": "Default"
              }
            },
            {
              "value": "slide",
              "label": {
                "fr": "Glisse depuis le bord le plus proche",
                "en": "Slide in from the nearest edge"
              }
            },
            {
              "value": "slideLeft",
              "label": {
                "fr": "Glisse depuis la gauche",
                "en": "Slide in from the left"
              }
            },
            {
              "value": "slideRight",
              "label": {
                "fr": "Glisse depuis la droite",
                "en": "Slide in from the right"
              }
            },
            {
              "value": "slideTop",
              "label": {
                "fr": "Glisse depuis le haut",
                "en": "Slide in from the top"
              }
            },
            {
              "value": "slideBottom",
              "label": {
                "fr": "Glisse depuis le bas",
                "en": "Slide in from the bottom"
              }
            },
            {
              "value": "fade",
              "label": {
                "fr": "Apparaît en fondu",
                "en": "Fade in"
              }
            },
            {
              "value": "jiggle",
              "label": {
                "fr": "Arrive avec un rebond",
                "en": "Jiggle in"
              }
            },
            {
              "value": "pop",
              "label": {
                "fr": "Surgit en zoom",
                "en": "Pop in"
              }
            },
            {
              "value": "none",
              "label": {
                "fr": "Instantané",
                "en": "Instant"
              }
            }
          ],
          "default": "module"
        },
        {
          "id": "transitionOut",
          "type": "choice",
          "label": {
            "fr": "Comment il part",
            "en": "How it leaves"
          },
          "choices": [
            {
              "value": "module",
              "label": {
                "fr": "Comme dans les réglages du module",
                "en": "Like the module settings"
              }
            },
            {
              "value": "same",
              "label": {
                "fr": "Comme l'arrivée",
                "en": "Same as how it enters"
              }
            },
            {
              "value": "slide",
              "label": {
                "fr": "Glisse vers le bord le plus proche",
                "en": "Slide out to the nearest edge"
              }
            },
            {
              "value": "slideLeft",
              "label": {
                "fr": "Glisse vers la gauche",
                "en": "Slide out to the left"
              }
            },
            {
              "value": "slideRight",
              "label": {
                "fr": "Glisse vers la droite",
                "en": "Slide out to the right"
              }
            },
            {
              "value": "slideTop",
              "label": {
                "fr": "Glisse vers le haut",
                "en": "Slide out to the top"
              }
            },
            {
              "value": "slideBottom",
              "label": {
                "fr": "Glisse vers le bas",
                "en": "Slide out to the bottom"
              }
            },
            {
              "value": "fade",
              "label": {
                "fr": "Disparaît en fondu",
                "en": "Fade out"
              }
            },
            {
              "value": "jiggle",
              "label": {
                "fr": "Rebondit, puis s'efface",
                "en": "Jiggle, then fade"
              }
            },
            {
              "value": "pop",
              "label": {
                "fr": "Disparaît en zoom",
                "en": "Pop out"
              }
            },
            {
              "value": "none",
              "label": {
                "fr": "Instantané",
                "en": "Instant"
              }
            }
          ],
          "default": "module"
        }
      ]
    }
  ]
}
