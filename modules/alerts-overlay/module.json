{
  "apiVersion": 2,
  "id": "alerts-overlay",
  "name": {
    "en": "Alerts overlay (OBS)",
    "fr": "Overlay alertes (OBS)"
  },
  "version": "1.8.2",
  "adminMenu": "Réseaux.Twitch",
  "adminMenuOrder": 50,
  "minCore": "0.10.0",
  "description": {
    "en": "A pop-up for OBS that shows your alerts one by one: follows, subs, gifts, bits, raids, hype trains.",
    "fr": "Une fenêtre pour OBS qui montre vos alertes une par une : follows, abonnements, cadeaux, bits, raids, trains de la hype."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "🔔",
  "main": "index.mjs",
  "type": "overlay",
  "instances": "multiple",
  "permissions": [
    "overlay",
    "routes",
    "topics",
    "admin",
    "mcp",
    "storage",
    "files"
  ],
  "settings": [
    {
      "key": "pushToken",
      "type": "secret",
      "advanced": true,
      "label": {
        "en": "Sending code",
        "fr": "Code d'envoi"
      },
      "help": {
        "en": "Whatever sends alerts must present it: Authorization: Bearer <token>. Without a token, nothing can push (except the test button).",
        "fr": "Ce qui envoie les alertes doit le présenter : Authorization: Bearer <jeton>. Sans jeton, rien ne peut pousser (sauf le bouton de test)."
      }
    },
    {
      "key": "youtubeText",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Show the text of YouTube messages",
        "fr": "Afficher le texte des messages YouTube"
      },
      "help": {
        "en": "A Super Chat message can contain anything your viewers write. Unticked (recommended), only the name and the amount are shown. Ticked, the text is shown too, cut to 140 characters, always as plain text.",
        "fr": "Le message d'un Super Chat peut contenir tout ce qu'écrit votre public. Décoché (recommandé), seuls le pseudo et le montant s'affichent. Coché, le texte s'affiche aussi, coupé à 140 caractères, toujours en texte brut."
      }
    },
    {
      "key": "visual",
      "type": "select",
      "default": "neon",
      "group": "appearance",
      "label": {
        "en": "Look",
        "fr": "Style"
      },
      "options": [
        {
          "value": "neon",
          "label": {
            "en": "Neon",
            "fr": "Néon"
          }
        },
        {
          "value": "plain",
          "label": {
            "en": "Plain",
            "fr": "Sobre"
          }
        }
      ]
    },
    {
      "key": "accentColor",
      "type": "color",
      "default": "theme:accent",
      "group": "appearance",
      "label": {
        "en": "Accent color",
        "fr": "Couleur d'accent"
      }
    },
    {
      "key": "durationSeconds",
      "type": "number",
      "default": 6,
      "label": {
        "en": "Seconds on screen",
        "fr": "Secondes à l'écran"
      }
    },
    {
      "key": "minGapSeconds",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 30,
      "unit": {
        "en": "seconds",
        "fr": "secondes"
      },
      "tab": "twitch",
      "label": {
        "en": "Pause between two alerts",
        "fr": "Pause entre deux alertes"
      },
      "help": {
        "en": "Between 0 and 30 seconds.",
        "fr": "Entre 0 et 30 secondes."
      }
    },
    {
      "key": "ignoreNames",
      "type": "text",
      "optional": true,
      "example": "etoile_nord, lune_douce",
      "tab": "twitch",
      "label": {
        "en": "Names to ignore",
        "fr": "Pseudos à ignorer"
      },
      "help": {
        "en": "No alert for these Twitch names. Separate them with commas.",
        "fr": "Pas d'alerte pour ces pseudos Twitch, séparés par des virgules."
      }
    },
    {
      "key": "twitchText",
      "type": "boolean",
      "default": false,
      "tab": "twitch",
      "label": {
        "en": "Show the messages that come with an alert",
        "fr": "Afficher les messages joints aux alertes"
      },
      "help": {
        "en": "A resub or bits can come with a message written by your viewers. Unticked, only the name and the amount are shown. Ticked, the message is shown too, cut to 140 characters, always as plain text.",
        "fr": "Un réabonnement ou des bits peuvent venir avec un message écrit par votre public. Décoché, seuls le pseudo et le montant s'affichent. Coché, le message s'affiche aussi, coupé à 140 caractères, toujours en texte brut."
      }
    },
    {
      "key": "groupSeconds",
      "type": "number",
      "default": 5,
      "min": 0,
      "max": 30,
      "unit": {
        "en": "seconds",
        "fr": "secondes"
      },
      "advanced": true,
      "tab": "twitch",
      "label": {
        "en": "Wait to group bursts",
        "fr": "Attente pour grouper les rafales"
      },
      "help": {
        "en": "Gifts from the same person and many follows in a row become one alert. 0 = never group.",
        "fr": "Les cadeaux d'une même personne et les nombreux follows d'affilée deviennent une seule alerte. 0 = ne jamais grouper."
      }
    },
    {
      "key": "twitchSounds",
      "type": "boolean",
      "default": false,
      "tab": "twitch",
      "label": {
        "en": "Play a sound with each alert",
        "fr": "Jouer un son avec chaque alerte"
      },
      "help": {
        "en": "Off by default. Pick the sound of each type in its edit window.",
        "fr": "Éteint par défaut. Choisissez le son de chaque type dans sa fenêtre."
      }
    },
    {
      "key": "soundVolume",
      "type": "number",
      "default": 50,
      "min": 0,
      "max": 100,
      "unit": {
        "en": "%",
        "fr": "%"
      },
      "advanced": true,
      "tab": "twitch",
      "label": {
        "en": "Volume of the alert sounds",
        "fr": "Volume des sons d'alerte"
      },
      "help": {
        "en": "Between 0 and 100.",
        "fr": "Entre 0 et 100."
      }
    },
    {
