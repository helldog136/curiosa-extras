{
  "apiVersion": 2,
  "id": "discord",
  "name": {
    "en": "Discord",
    "fr": "Discord"
  },
  "version": "1.3.0",
  "platform": "discord",
  "description": {
    "en": "Shows your Discord button in the site header, shares your member count and can create the short address /discord.",
    "fr": "Affiche le bouton de votre Discord dans l'en-tête, partage le nombre de vos membres et peut créer l'adresse courte /discord."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "💬",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Discord button in the header",
        "fr": "Bouton Discord dans l'en-tête"
      }
    },
    {
      "topic": "social.stat",
      "label": {
        "en": "Discord members",
        "fr": "Membres Discord"
      }
    }
  ],
  "permissions": [
    "admin"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Statistiques",
        "en": "Statistics"
      }
    }
  ],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste your invitation link.",
        "fr": "Collez votre lien d'invitation."
      },
      "example": {
        "en": "https://discord.gg/abcDEF",
        "fr": "https://discord.gg/abcDEF"
      }
    },
    {
      "key": "trackStats",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Follow my statistics",
        "fr": "Suivre mes statistiques"
      },
      "help": {
        "en": "Counts your server's members for the site's statistics (an approximate number, read from the invitation link).",
        "fr": "Compte les membres de votre serveur pour les statistiques du site (un nombre approximatif, lu à partir du lien d'invitation)."
      }
    },
    {
      "key": "createShortLink",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Create a short address for your Discord",
        "fr": "Créer une adresse courte pour votre Discord"
      },
      "help": {
        "en": "It stays the same if your invitation changes.",
        "fr": "Elle reste la même si votre invitation change."
      }
    },
    {
      "key": "invite",
      "type": "text",
      "label": {
        "en": "Invitation link",
        "fr": "Lien d'invitation"
      },
      "help": {
        "en": "Only if the address above is not an invitation.",
        "fr": "Seulement si l'adresse ci-dessus n'est pas une invitation."
      },
      "optional": true,
      "example": {
        "en": "https://discord.gg/abcDEF",
        "fr": "https://discord.gg/abcDEF"
      },
      "rare": true
    },
    {
      "key": "shortLinkName",
      "type": "text",
      "label": {
        "en": "Name of the short address",
        "fr": "Nom de l'adresse courte"
      },
      "help": {
        "en": "Letters, digits and dashes. Empty: discord.",
        "fr": "Lettres, chiffres et tirets. Vide : discord."
      },
      "optional": true,
      "example": {
        "en": "discord-fr",
        "fr": "discord-fr"
      },
      "rare": true
    }
  ],
  "minCore": "0.6.0",
  "shortLink": {
    "enabled": "createShortLink",
    "name": "shortLinkName",
    "default": "discord",
    "target": "social.link"
  },
  "social": {
    "name": "Discord",
    "icon": "discord",
    "hosts": [
      "discord.gg",
      "discord.com",
      "discordapp.com"
    ],
    "template": "https://discord.gg/{h}",
    "example": {
      "en": "https://discord.gg/abcDEF",
      "fr": "https://discord.gg/abcDEF"
    },
    "shapes": [
      {
        "host": "^discord\\.gg$",
        "re": "^/([A-Za-z0-9-]{2,32})/?$",
        "handle": true
      },
      {
        "host": "^discord(?:app)?\\.com$",
        "re": "^/invite/([A-Za-z0-9-]{2,32})/?$",
        "handle": true
      }
    ]
  }
}
