{
  "apiVersion": 2,
  "id": "discord",
  "name": {
    "en": "Discord",
    "fr": "Discord"
  },
  "version": "1.5.0",
  "adminMenu": "Réseaux.Discord",
  "adminMenuOrder": 10,
  "platform": "discord",
  "description": {
    "en": "Shows your Discord button in the site header and shares your member count.",
    "fr": "Affiche le bouton de votre Discord dans l'en-tête et partage le nombre de vos membres."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "💬",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Discord button in the header",
        "fr": "Bouton Discord dans l'en-tête"
      }
    },
    {
      "topic": "social.stat",
      "label": {
        "en": "Discord members",
        "fr": "Membres Discord"
      }
    }
  ],
  "permissions": [
    "admin"
  ],
  "requires": [
    {
      "service": "discord.api",
      "min": 1,
      "optional": true,
      "label": {
        "en": "Counts your members with your Discord bot",
        "fr": "Compte vos membres avec votre bot Discord"
      }
    }
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Statistiques",
        "en": "Statistics"
      }
    }
  ],
  "places": [
    {
      "id": "main",
      "place": "networks.discord",
      "order": 200,
      "settings": [
        "profile",
        "createShortLink",
        "invite",
        "shortLinkName"
      ],
      "seeAlso": [
        "live.golive",
        "networks.stats"
      ]
    },
    {
      "id": "stats",
      "place": "networks.stats",
      "order": 200,
      "fromTab": "settings",
      "settings": [
        "trackStats"
      ],
      "seeAlso": [
        "networks.discord"
      ]
    }
  ],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your invitation link",
        "fr": "Votre lien d'invitation"
      },
      "example": {
        "en": "https://discord.gg/abcDEF",
        "fr": "https://discord.gg/abcDEF"
      }
    },
    {
      "key": "trackStats",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Follow my statistics",
        "fr": "Suivre mes statistiques"
      },
      "help": {
        "en": "Counts your server's members. The number is approximate.",
        "fr": "Compte les membres de votre serveur. Le nombre est approximatif."
      }
    },
    {
      "key": "createShortLink",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Create a short address for your Discord",
        "fr": "Créer une adresse courte pour votre Discord"
      },
      "help": {
        "en": "It stays the same if your invitation changes.",
        "fr": "Elle reste la même si votre invitation change."
      }
    },
    {
      "key": "invite",
      "type": "text",
      "label": {
        "en": "Invitation used to count members",
        "fr": "Invitation pour compter les membres"
      },
      "optional": true,
      "example": {
        "en": "https://discord.gg/abcDEF",
        "fr": "https://discord.gg/abcDEF"
      },
      "rare": true
    },
    {
      "key": "shortLinkName",
      "type": "text",
      "label": {
        "en": "Name of the short address",
        "fr": "Nom de l'adresse courte"
      },
      "help": {
        "en": "Letters, digits and dashes. Empty: discord.",
        "fr": "Lettres, chiffres et tirets. Vide : discord."
      },
      "optional": true,
      "example": {
        "en": "discord-fr",
        "fr": "discord-fr"
      },
      "rare": true
    }
  ],
  "minCore": "0.6.0",
  "shortLink": {
    "enabled": "createShortLink",
    "name": "shortLinkName",
    "default": "discord",
    "target": "social.link"
  },
  "social": {
    "name": "Discord",
    "icon": "discord",
    "hosts": [
      "discord.gg",
      "discord.com",
      "discordapp.com"
    ],
    "template": "https://discord.gg/{h}",
    "example": {
      "en": "https://discord.gg/abcDEF",
      "fr": "https://discord.gg/abcDEF"
    },
    "shapes": [
      {
        "host": "^discord\\.gg$",
        "re": "^/([A-Za-z0-9-]{2,32})/?$",
        "handle": true
      },
      {
        "host": "^discord(?:app)?\\.com$",
        "re": "^/invite/([A-Za-z0-9-]{2,32})/?$",
        "handle": true
      }
    ]
  }
}
