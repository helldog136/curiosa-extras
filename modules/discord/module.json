{
  "apiVersion": 2,
  "id": "discord",
  "name": {
    "en": "Discord",
    "fr": "Discord"
  },
  "version": "1.2.0",
  "platform": "discord",
  "description": {
    "en": "Shows your Discord button in the site header and shares your member count.",
    "fr": "Affiche le bouton de votre Discord dans l'en-tête et partage le nombre de vos membres."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "💬",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Discord button in the header",
        "fr": "Bouton Discord dans l'en-tête"
      }
    },
    {
      "topic": "social.stat",
      "label": {
        "en": "Discord members",
        "fr": "Membres Discord"
      }
    }
  ],
  "permissions": [
    "admin"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Statistiques",
        "en": "Statistics"
      }
    }
  ],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste your invitation link.",
        "fr": "Collez votre lien d'invitation."
      },
      "example": {
        "en": "https://discord.gg/abcDEF",
        "fr": "https://discord.gg/abcDEF"
      }
    },
    {
      "key": "trackStats",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Follow my statistics",
        "fr": "Suivre mes statistiques"
      },
      "help": {
        "en": "Counts your server's members for the site's statistics (an approximate number, read from the invitation link).",
        "fr": "Compte les membres de votre serveur pour les statistiques du site (un nombre approximatif, lu à partir du lien d'invitation)."
      }
    },
    {
      "key": "invite",
      "type": "text",
      "label": {
        "en": "Invitation link",
        "fr": "Lien d'invitation"
      },
      "help": {
        "en": "Only if the address above is not an invitation.",
        "fr": "Seulement si l'adresse ci-dessus n'est pas une invitation."
      },
      "optional": true,
      "example": {
        "en": "https://discord.gg/abcDEF",
        "fr": "https://discord.gg/abcDEF"
      },
      "rare": true
    }
  ],
  "minCore": "0.6.0"
}
