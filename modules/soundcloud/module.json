{
  "apiVersion": 2,
  "id": "soundcloud",
  "name": {
    "en": "SoundCloud",
    "fr": "SoundCloud"
  },
  "version": "1.1.0",
  "platform": "soundcloud",
  "description": {
    "en": "Shows your SoundCloud button in the site header.",
    "fr": "Affiche le bouton de votre SoundCloud dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "☁️",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "SoundCloud button in the header",
        "fr": "Bouton SoundCloud dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://soundcloud.com/myname",
        "fr": "https://soundcloud.com/monpseudo"
      }
    }
  ],
  "minCore": "0.6.0"
}
