{
  "apiVersion": 2,
  "id": "ticker-overlay",
  "name": {
    "en": "Ticker overlay (OBS)",
    "fr": "Overlay défilant (OBS)"
  },
  "version": "1.1.0",
  "minCore": "0.5.0",
  "main": "index.mjs",
  "description": {
    "en": "A transparent browser source for OBS that rotates cards from your site (promo codes, articles, announcements…).",
    "fr": "Une source navigateur transparente pour OBS qui fait défiler des cartes issues de votre site (codes promo, articles, annonces…)."
  },
  "author": "Helldog136",
  "license": "Curiosa License 1.0",
  "icon": "📺",
  "type": "overlay",
  "instances": "multiple",
  "sections": [],
  "provides": [],
  "consumes": [
    {
      "topic": "core.entry",
      "label": {
        "en": "Entries of your blogs, codes, links…",
        "fr": "Entrées de vos blogs, codes, liens…"
      },
      "tags": true
    },
    {
      "topic": "overlay.item",
      "label": {
        "en": "Items offered by other modules",
        "fr": "Éléments proposés par d'autres modules"
      },
      "schema": [
        {
          "key": "title",
          "type": "string",
          "required": true
        },
        {
          "key": "text",
          "type": "string"
        },
        {
          "key": "image",
          "type": "url"
        },
        {
          "key": "url",
          "type": "url"
        }
      ]
    }
  ],
  "permissions": [
    "overlay",
    "routes",
    "topics"
  ],
  "settings": [
    {
      "key": "interval",
      "type": "number",
      "default": 8,
      "label": {
        "en": "Seconds per card",
        "fr": "Secondes par carte"
      }
    },
    {
      "key": "textColor",
      "type": "color",
      "group": "appearance",
      "default": "theme:fg",
      "label": {
        "en": "Text color",
        "fr": "Couleur du texte"
      }
    },
    {
      "key": "cardColor",
      "type": "color",
      "group": "appearance",
      "default": "theme:surface",
      "label": {
        "en": "Card color",
        "fr": "Couleur de la carte"
      }
    },
    {
      "key": "position",
      "type": "select",
      "group": "appearance",
      "default": "bottom-left",
      "label": {
        "en": "Position",
        "fr": "Position"
      },
      "options": [
        {
          "value": "bottom-left",
          "label": {
            "en": "Bottom left",
            "fr": "Bas gauche"
          }
        },
        {
          "value": "bottom-right",
          "label": {
            "en": "Bottom right",
            "fr": "Bas droite"
          }
        },
        {
          "value": "top-left",
          "label": {
            "en": "Top left",
            "fr": "Haut gauche"
          }
        },
        {
          "value": "top-right",
          "label": {
            "en": "Top right",
            "fr": "Haut droite"
          }
        }
      ]
    }
  ],
  "overlayElements": [
    {
      "id": "banner",
      "label": {
        "fr": "Bandeau défilant",
        "en": "Scrolling banner"
      },
      "description": {
        "fr": "Un bandeau d'annonces et de codes promo, à placer en bas du stream : une carte à la fois, qui change toutes les quelques secondes.",
        "en": "A banner of announcements and promo codes for the bottom of the stream: one card at a time, changing every few seconds."
      },
      "fit": "scale",
      "size": {
        "width": 640,
        "height": 140
      },
      "followsStyle": true,
      "demo": true,
      "options": [
        {
          "id": "show",
          "type": "choice",
          "label": {
            "fr": "Quoi montrer",
            "en": "What to show"
          },
          "help": {
            "fr": "Utile pour avoir un bandeau de codes promo et un autre d'annonces.",
            "en": "Handy to have one banner for promo codes and another for announcements."
          },
          "choices": [
            {
              "value": "all",
              "label": {
                "fr": "Tout",
                "en": "Everything"
              }
            },
            {
              "value": "codes",
              "label": {
                "fr": "Codes promo seulement",
                "en": "Promo codes only"
              }
            },
            {
              "value": "news",
              "label": {
                "fr": "Annonces et articles seulement",
                "en": "Announcements and articles only"
              }
            }
          ],
          "default": "all"
        },
        {
          "id": "image",
          "type": "boolean",
          "label": {
            "fr": "Montrer les images",
            "en": "Show the pictures"
          },
          "help": {
            "fr": "Les images des cartes, quand elles en ont une.",
            "en": "The picture of each card, when it has one."
          },
          "default": true
        }
      ]
    }
  ]
}
