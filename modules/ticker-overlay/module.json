{
  "apiVersion": 2,
  "id": "ticker-overlay",
  "name": {
    "en": "Ticker overlay (OBS)",
    "fr": "Overlay défilant (OBS)"
  },
  "version": "1.2.0",
  "minCore": "0.6.0",
  "main": "index.mjs",
  "description": {
    "en": "A transparent browser source for OBS that rotates cards from your site (promo codes, articles, announcements…).",
    "fr": "Une source navigateur transparente pour OBS qui fait défiler des cartes issues de votre site (codes promo, articles, annonces…)."
  },
  "author": "Helldog136",
  "license": "Curiosa License 1.0",
  "icon": "📺",
  "type": "overlay",
  "instances": "multiple",
  "sections": [],
  "provides": [],
  "consumes": [
    {
      "topic": "core.entry",
      "label": {
        "en": "Entries of your blogs, codes, links…",
        "fr": "Entrées de vos blogs, codes, liens…"
      },
      "tags": true
    },
    {
      "topic": "overlay.item",
      "label": {
        "en": "Items offered by other modules",
        "fr": "Éléments proposés par d'autres modules"
      },
      "schema": [
        {
          "key": "title",
          "type": "string",
          "required": true
        },
        {
          "key": "text",
          "type": "string"
        },
        {
          "key": "image",
          "type": "url"
        },
        {
          "key": "url",
          "type": "url"
        }
      ]
    }
  ],
  "permissions": [
    "overlay",
    "routes",
    "topics"
  ],
  "settings": [
    {
      "key": "interval",
      "type": "number",
      "default": 8,
      "label": {
        "en": "Seconds per card",
        "fr": "Secondes par carte"
      }
    },
    {
      "key": "textColor",
      "type": "color",
      "group": "appearance",
      "default": "theme:fg",
      "label": {
        "en": "Text color",
        "fr": "Couleur du texte"
      }
    },
    {
      "key": "cardColor",
      "type": "color",
      "group": "appearance",
      "default": "theme:surface",
      "label": {
        "en": "Card color",
        "fr": "Couleur de la carte"
      }
    },
    {
      "key": "position",
      "type": "select",
      "group": "appearance",
      "default": "bottom-left",
      "label": {
        "en": "Position",
        "fr": "Position"
      },
      "options": [
        {
          "value": "bottom-left",
          "label": {
            "en": "Bottom left",
            "fr": "Bas gauche"
          }
        },
        {
          "value": "bottom-right",
          "label": {
            "en": "Bottom right",
            "fr": "Bas droite"
          }
        },
        {
          "value": "top-left",
          "label": {
            "en": "Top left",
            "fr": "Haut gauche"
          }
        },
        {
          "value": "top-right",
          "label": {
            "en": "Top right",
            "fr": "Haut droite"
          }
        }
      ]
    },
    {
      "key": "transitionIn",
      "type": "select",
      "default": "auto",
      "rare": true,
      "label": {
        "fr": "Comment il arrive",
        "en": "How it enters"
      },
      "help": {
        "fr": "« Par défaut » garde le style actuel.",
        "en": "\"Default\" keeps the current look."
      },
      "options": [
        {
          "value": "auto",
          "label": {
            "fr": "Par défaut",
            "en": "Default"
          }
        },
        {
          "value": "slide",
          "label": {
            "fr": "Glisse depuis le bord le plus proche",
            "en": "Slide in from the nearest edge"
          }
        },
        {
          "value": "slideLeft",
          "label": {
            "fr": "Glisse depuis la gauche",
            "en": "Slide in from the left"
          }
        },
        {
          "value": "slideRight",
          "label": {
            "fr": "Glisse depuis la droite",
            "en": "Slide in from the right"
          }
        },
        {
          "value": "slideTop",
          "label": {
            "fr": "Glisse depuis le haut",
            "en": "Slide in from the top"
          }
        },
        {
          "value": "slideBottom",
          "label": {
            "fr": "Glisse depuis le bas",
            "en": "Slide in from the bottom"
          }
        },
        {
          "value": "fade",
          "label": {
            "fr": "Apparaît en fondu",
            "en": "Fade in"
          }
        },
        {
          "value": "jiggle",
          "label": {
            "fr": "Arrive avec un rebond",
            "en": "Jiggle in"
          }
        },
        {
          "value": "pop",
          "label": {
            "fr": "Surgit en zoom",
            "en": "Pop in"
          }
        },
        {
          "value": "none",
          "label": {
            "fr": "Instantané",
            "en": "Instant"
          }
        }
      ]
    },
    {
      "key": "transitionOut",
      "type": "select",
      "default": "same",
      "rare": true,
      "label": {
        "fr": "Comment il part",
        "en": "How it leaves"
      },
      "help": {
        "fr": "« Comme l'arrivée » la joue à l'envers.",
        "en": "\"Same\" plays the entrance backwards."
      },
      "options": [
        {
          "value": "same",
          "label": {
            "fr": "Comme l'arrivée",
            "en": "Same as how it enters"
          }
        },
        {
          "value": "slide",
          "label": {
            "fr": "Glisse vers le bord le plus proche",
            "en": "Slide out to the nearest edge"
          }
        },
        {
          "value": "slideLeft",
          "label": {
            "fr": "Glisse vers la gauche",
            "en": "Slide out to the left"
          }
        },
        {
          "value": "slideRight",
          "label": {
            "fr": "Glisse vers la droite",
            "en": "Slide out to the right"
          }
        },
        {
          "value": "slideTop",
          "label": {
            "fr": "Glisse vers le haut",
            "en": "Slide out to the top"
          }
        },
        {
          "value": "slideBottom",
          "label": {
            "fr": "Glisse vers le bas",
            "en": "Slide out to the bottom"
          }
        },
        {
          "value": "fade",
          "label": {
            "fr": "Disparaît en fondu",
            "en": "Fade out"
          }
        },
        {
          "value": "jiggle",
          "label": {
            "fr": "Rebondit, puis s'efface",
            "en": "Jiggle, then fade"
          }
        },
        {
          "value": "pop",
          "label": {
            "fr": "Disparaît en zoom",
            "en": "Pop out"
          }
        },
        {
          "value": "none",
          "label": {
            "fr": "Instantané",
            "en": "Instant"
          }
        }
      ]
    },
    {
      "key": "transitionSeconds",
      "type": "number",
      "default": 0.5,
      "rare": true,
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "unit": {
        "fr": "secondes",
        "en": "seconds"
      },
      "label": {
        "fr": "Durée du mouvement",
        "en": "Length of the movement"
      }
    }
  ],
  "overlayElements": [
    {
      "id": "banner",
      "label": {
        "fr": "Bandeau défilant",
        "en": "Scrolling banner"
      },
      "description": {
        "fr": "Un bandeau d'annonces et de codes promo, à placer en bas du stream : une carte à la fois, qui change toutes les quelques secondes.",
        "en": "A banner of announcements and promo codes for the bottom of the stream: one card at a time, changing every few seconds."
      },
      "fit": "scale",
      "size": {
        "width": 640,
        "height": 140
      },
      "followsStyle": true,
      "demo": true,
      "options": [
        {
          "id": "show",
          "type": "choice",
          "label": {
            "fr": "Quoi montrer",
            "en": "What to show"
          },
          "help": {
            "fr": "Utile pour avoir un bandeau de codes promo et un autre d'annonces.",
            "en": "Handy to have one banner for promo codes and another for announcements."
          },
          "choices": [
            {
              "value": "all",
              "label": {
                "fr": "Tout",
                "en": "Everything"
              }
            },
            {
              "value": "codes",
              "label": {
                "fr": "Codes promo seulement",
                "en": "Promo codes only"
              }
            },
            {
              "value": "news",
              "label": {
                "fr": "Annonces et articles seulement",
                "en": "Announcements and articles only"
              }
            }
          ],
          "default": "all"
        },
        {
          "id": "image",
          "type": "boolean",
          "label": {
            "fr": "Montrer les images",
            "en": "Show the pictures"
          },
          "help": {
            "fr": "Les images des cartes, quand elles en ont une.",
            "en": "The picture of each card, when it has one."
          },
          "default": true
        },
        {
          "id": "transitionIn",
          "type": "choice",
          "label": {
            "fr": "Comment il arrive",
            "en": "How it enters"
          },
          "choices": [
            {
              "value": "module",
              "label": {
                "fr": "Comme dans les réglages du module",
                "en": "Like the module settings"
              }
            },
            {
              "value": "auto",
              "label": {
                "fr": "Par défaut",
                "en": "Default"
              }
            },
            {
              "value": "slide",
              "label": {
                "fr": "Glisse depuis le bord le plus proche",
                "en": "Slide in from the nearest edge"
              }
            },
            {
              "value": "slideLeft",
              "label": {
                "fr": "Glisse depuis la gauche",
                "en": "Slide in from the left"
              }
            },
            {
              "value": "slideRight",
              "label": {
                "fr": "Glisse depuis la droite",
                "en": "Slide in from the right"
              }
            },
            {
              "value": "slideTop",
              "label": {
                "fr": "Glisse depuis le haut",
                "en": "Slide in from the top"
              }
            },
            {
              "value": "slideBottom",
              "label": {
                "fr": "Glisse depuis le bas",
                "en": "Slide in from the bottom"
              }
            },
            {
              "value": "fade",
              "label": {
                "fr": "Apparaît en fondu",
                "en": "Fade in"
              }
            },
            {
              "value": "jiggle",
              "label": {
                "fr": "Arrive avec un rebond",
                "en": "Jiggle in"
              }
            },
            {
              "value": "pop",
              "label": {
                "fr": "Surgit en zoom",
                "en": "Pop in"
              }
            },
            {
              "value": "none",
              "label": {
                "fr": "Instantané",
                "en": "Instant"
              }
            }
          ],
          "default": "module"
        },
        {
          "id": "transitionOut",
          "type": "choice",
          "label": {
            "fr": "Comment il part",
            "en": "How it leaves"
          },
          "choices": [
            {
              "value": "module",
              "label": {
                "fr": "Comme dans les réglages du module",
                "en": "Like the module settings"
              }
            },
            {
              "value": "same",
              "label": {
                "fr": "Comme l'arrivée",
                "en": "Same as how it enters"
              }
            },
            {
              "value": "slide",
              "label": {
                "fr": "Glisse vers le bord le plus proche",
                "en": "Slide out to the nearest edge"
              }
            },
            {
              "value": "slideLeft",
              "label": {
                "fr": "Glisse vers la gauche",
                "en": "Slide out to the left"
              }
            },
            {
              "value": "slideRight",
              "label": {
                "fr": "Glisse vers la droite",
                "en": "Slide out to the right"
              }
            },
            {
              "value": "slideTop",
              "label": {
                "fr": "Glisse vers le haut",
                "en": "Slide out to the top"
              }
            },
            {
              "value": "slideBottom",
              "label": {
                "fr": "Glisse vers le bas",
                "en": "Slide out to the bottom"
              }
            },
            {
              "value": "fade",
              "label": {
                "fr": "Disparaît en fondu",
                "en": "Fade out"
              }
            },
            {
              "value": "jiggle",
              "label": {
                "fr": "Rebondit, puis s'efface",
                "en": "Jiggle, then fade"
              }
            },
            {
              "value": "pop",
              "label": {
                "fr": "Disparaît en zoom",
                "en": "Pop out"
              }
            },
            {
              "value": "none",
              "label": {
                "fr": "Instantané",
                "en": "Instant"
              }
            }
          ],
          "default": "module"
        }
      ]
    }
  ]
}
