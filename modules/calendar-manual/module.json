{
  "apiVersion": 2,
  "minCore": "0.6.0",
  "id": "calendar-manual",
  "name": {
    "en": "Hand-written streams",
    "fr": "Streams saisis à la main"
  },
  "version": "1.3.1",
  "menuGroup": "tools",
  "description": {
    "en": "Write your streams here (day, time, games, every week) and your site shows them: the schedule, the chat bot… No Google account or calendar to set up.",
    "fr": "Écrivez vos streams ici (jour, heure, jeux, chaque semaine) et votre site les montre : le planning, le bot du chat… Aucun compte Google ni agenda à régler."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "✍️",
  "dashboard": {
    "quickActions": [
      {
        "id": "add",
        "label": {
          "en": "Schedule a stream",
          "fr": "Programmer un stream"
        },
        "href": "?tab=use"
      }
    ]
  },
  "main": "index.mjs",
  "type": "utility",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "planning.slot",
      "label": {
        "en": "Streams written by hand",
        "fr": "Streams saisis à la main"
      }
    }
  ],
  "permissions": [
    "topics",
    "storage",
    "admin"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Mes streams",
        "en": "My streams"
      }
    }
  ],
  "places": [
    {
      "id": "streams",
      "place": "calendar.schedule.streams",
      "order": 200,
      "fromTab": "settings"
    }
  ],
  "settings": [
    {
      "key": "timezone",
      "type": "text",
      "default": "Europe/Paris",
      "advanced": true,
      "label": {
        "en": "Time zone of the times you type",
        "fr": "Fuseau horaire des heures que vous tapez"
      },
      "help": {
        "fr": "Par exemple Europe/Paris ou America/Montreal.",
        "en": "For example Europe/Paris or America/Montreal."
      }
    }
  ]
}
