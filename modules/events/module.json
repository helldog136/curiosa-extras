{
  "apiVersion": 2,
  "id": "events",
  "name": {
    "fr": "Événements",
    "en": "Events"
  },
  "version": "1.0.0",
  "minCore": "0.2.6",
  "description": {
    "fr": "Un agenda d'événements et de formations : les prochains rendez-vous avec filtre par type et recherche, un calendrier du mois, une fiche détaillée (heure chez le visiteur, programme, intervenants, inscription, vidéo, ajout à son agenda) et la rétrospective des événements passés.",
    "en": "An agenda of events and trainings: upcoming dates with a filter by type and search, a monthly calendar, a detailed page (time where the visitor lives, programme, speakers, sign-up, video, add to one's calendar) and a look back at past events."
  },
  "author": "Helldog136",
  "license": "Curiosa License 1.0",
  "icon": "📅",
  "main": "index.mjs",
  "type": "widget",
  "instances": "multiple",
  "page": true,
  "basePath": "events",
  "privacy": {
    "fr": "Ce module ne demande ni nom ni e-mail et ne dépose aucun cookie. Pour limiter les abus, il retient en mémoire seulement, 24 heures au plus, une empreinte non réversible de votre connexion. Une vidéo YouTube ne se charge qu'après votre clic : YouTube reçoit alors votre adresse. Les liens d'inscription, de carte et de galerie mènent vers d'autres sites.",
    "en": "This extension asks for no name or e-mail and sets no cookie. To limit abuse it only keeps in memory, for 24 hours at most, a one-way fingerprint of your connection. A YouTube video only loads after you click: YouTube then receives your address. Sign-up, map and gallery links lead to other sites."
  },
  "permissions": [
    "sections",
    "pages",
    "routes",
    "storage",
    "topics",
    "mcp",
    "admin"
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Mes événements",
        "en": "My events"
      }
    },
    {
      "id": "more",
      "label": {
        "fr": "Types et fichiers",
        "en": "Types and files"
      },
      "panel": true
    }
  ],
  "rights": [
    {
      "id": "events.edit",
      "label": {
        "fr": "écrire et organiser les événements",
        "en": "write and organise the events"
      },
      "help": {
        "fr": "Ajouter, modifier, dupliquer, répéter, publier, retirer et supprimer des événements et des types, importer et exporter un fichier. Sans ce droit, on ne fait que lire.",
        "en": "Add, edit, duplicate, repeat, publish, unpublish and delete events and types, import and export a file. Without this right, a person can only read."
      },
      "default": {
        "admin": true,
        "editor": false
      }
    }
  ],
