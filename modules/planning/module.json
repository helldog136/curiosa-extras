{
  "apiVersion": 2,
  "id": "planning",
  "name": {
    "en": "Stream schedule",
    "fr": "Planning des streams"
  },
  "version": "2.5.0",
  "minCore": "0.5.0",
  "description": {
    "fr": "Affiche vos prochains streams dans l'apparence de votre choix : liste, alternance, semaine, timeline, affiches… Les streams viennent de votre Google Agenda ou de ce que vous écrivez à la main.",
    "en": "Shows your upcoming streams in the look you choose: list, zigzag, week, timeline, posters… Streams come from your Google Calendar or from what you write by hand."
  },
  "privacy": {
    "en": "This module collects nothing itself. When game covers are shown, your browser loads those pictures from RAWG (a video-game database), so RAWG sees your address, under its own privacy policy. Without a cover, nothing is loaded from elsewhere.",
    "fr": "Ce module ne collecte rien lui-même. Quand des jaquettes de jeux sont affichées, votre navigateur charge ces images depuis RAWG (une base de données de jeux vidéo) : RAWG voit alors votre adresse, selon sa propre politique de confidentialité. Sans jaquette, rien n'est chargé ailleurs."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "📅",
  "main": "index.mjs",
  "type": "widget",
  "instances": "multiple",
  "page": true,
  "basePath": "planning",
  "sections": [
    {
      "id": "upcoming",
      "label": {
        "en": "Next streams",
        "fr": "Prochains streams"
      },
      "options": [
        {
          "key": "count",
          "type": "number",
          "default": 5,
          "label": {
            "en": "How many",
            "fr": "Combien"
          }
        },
        {
          "key": "appearance",
          "type": "select",
          "default": "inherit",
          "label": {
            "en": "Look",
            "fr": "Apparence"
          },
          "options": [
            {
              "value": "inherit",
              "label": {
                "en": "Same as the schedule page",
                "fr": "Comme la page du planning"
              }
            },
            {
              "value": "original",
              "label": {
                "en": "Simple list (original look)",
                "fr": "Liste simple (affichage d'origine)"
              }
            },
            {
              "value": "classic",
              "label": {
                "en": "Classic list",
                "fr": "Liste classique"
              }
            },
            {
              "value": "alternating",
              "label": {
                "en": "Alternating list",
                "fr": "Liste en alternance"
              }
            },
            {
              "value": "week",
              "label": {
                "en": "Week grid",
                "fr": "Semaine en grille"
              }
            },
            {
              "value": "timeline",
              "label": {
                "en": "Timeline",
                "fr": "Timeline"
              }
            },
            {
              "value": "posters",
              "label": {
                "en": "Posters",
                "fr": "Affiches"
              }
            },
            {
              "value": "hero",
              "label": {
                "en": "Spotlight + up next",
                "fr": "À la une + à suivre"
              }
            }
          ]
        }
      ],
      "size": "large"
    },
    {
      "id": "next",
      "label": {
        "en": "Next stream",
        "fr": "Prochain stream"
      },
      "size": "small"
    },
    {
      "id": "days",
      "label": {
        "en": "The next days (compact)",
        "fr": "Les prochains jours (miniature)"
      },
      "size": "medium",
      "options": [
        {
          "key": "count",
          "type": "number",
          "default": 3,
          "label": {
            "en": "How many days",
            "fr": "Combien de jours"
          }
        }
      ]
    }
  ],
  "consumes": [
    {
      "topic": "planning.slot",
      "label": {
        "en": "Your streams (from your online calendar or hand-written streams)",
        "fr": "Vos streams (fournis par votre agenda en ligne ou vos streams saisis à la main)"
      },
      "schema": [
        {
          "key": "id",
          "type": "string"
        },
        {
          "key": "title",
          "type": "string",
          "required": true
        },
        {
          "key": "start",
          "type": "datetime",
          "required": true
        },
        {
          "key": "end",
          "type": "datetime"
        },
        {
          "key": "allDay",
          "type": "boolean"
        },
        {
          "key": "day",
          "type": "string"
        },
        {
          "key": "games",
          "type": "string[]"
        },
        {
          "key": "status",
          "type": "string"
        },
        {
          "key": "timezone",
          "type": "string"
        }
      ]
    },
    {
      "topic": "social.link",
      "label": {
        "en": "Your Twitch channel link (from the Twitch channel module)",
        "fr": "Le lien de votre chaîne (fourni par la Chaîne Twitch)"
      },
      "schema": [
        {
          "key": "label",
          "type": "string"
        },
        {
          "key": "url",
          "type": "url",
          "required": true
        },
        {
          "key": "icon",
          "type": "string"
        }
      ]
    }
  ],
  "permissions": [
    "pages",
    "routes",
    "sections",
    "admin",
    "topics",
    "mcp",
    "rawg"
  ],
  "requires": [
    {
      "service": "game.cover",
      "optional": true
    }
  ],
  "tabs": [
    {
      "id": "use",
      "label": {
        "fr": "Créneaux",
        "en": "Slots"
      }
    },
    {
      "id": "look",
      "label": {
        "fr": "Apparence",
        "en": "Appearance"
      }
    }
  ],
  "settings": [
    {
      "key": "channelUrl",
      "type": "url",
      "label": {
        "en": "Channel link (“Watch on Twitch” button)",
        "fr": "Lien de votre chaîne (bouton « Regarder sur Twitch »)"
      },
      "help": {
        "en": "Optional. Not needed if the Twitch channel module is installed with your channel: its link is used. Without any link, the button is not shown.",
        "fr": "Facultatif. Inutile si la Chaîne Twitch est installée avec votre chaîne : son lien est repris. Sans lien, le bouton n'est pas affiché."
      },
      "optional": true
    },
    {
      "key": "days",
      "type": "number",
      "default": 7,
      "advanced": true,
      "label": {
        "en": "Days shown on the page",
        "fr": "Jours affichés sur la page"
      }
    },
    {
      "key": "timezone",
      "type": "text",
      "advanced": true,
      "label": {
        "en": "Time zone for display (optional)",
        "fr": "Fuseau horaire d'affichage (facultatif)"
      },
      "help": {
        "en": "IANA name, e.g. Europe/Paris, America/Montreal. Left empty, the time zone of your calendars is used.",
        "fr": "Nom IANA, ex. Europe/Paris, America/Montreal. Laissé vide, c'est le fuseau de vos agendas qui est utilisé."
      },
      "optional": true
    },
    {
      "key": "appearance",
      "type": "select",
      "default": "original",
      "group": "appearance",
