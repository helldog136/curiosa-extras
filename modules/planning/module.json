      "group": "appearance",
      "tab": "look",
      "label": {
        "en": "Week grid: weeks",
        "fr": "Semaine en grille : semaines"
      },
      "help": {
        "en": "Calendar: starts on the first day of the week. Rolling: seven days from today.",
        "fr": "Calendrier : commence le premier jour de la semaine. Glissantes : sept jours à partir d'aujourd'hui."
      },
      "options": [
        {
          "value": "calendar",
          "label": {
            "en": "Calendar weeks",
            "fr": "Semaines du calendrier"
          }
        },
        {
          "value": "rolling",
          "label": {
            "en": "Seven days from today",
            "fr": "Sept jours à partir d'aujourd'hui"
          }
        }
      ]
    },
    {
      "key": "timelineEmpty",
      "type": "boolean",
      "default": false,
      "advanced": true,
      "group": "appearance",
      "tab": "look",
      "label": {
        "en": "Timeline: also show days without a stream",
        "fr": "Timeline : montrer aussi les jours sans stream"
      }
    },
    {
      "key": "heroUpNext",
      "type": "number",
      "default": 5,
      "advanced": true,
      "group": "appearance",
      "tab": "look",
      "label": {
        "en": "Spotlight: how many “up next” streams",
        "fr": "À la une : combien de streams « à suivre »"
      }
    }
