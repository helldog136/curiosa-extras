        {
          "id": "covers",
          "type": "boolean",
          "default": true,
          "label": {
            "en": "Show game covers",
            "fr": "Montrer les jaquettes"
          },
          "help": {
            "en": "The pictures of the games, when available. In a grid that is too short, they are hidden.",
            "fr": "Les images des jeux, quand elles sont disponibles. Dans une grille trop basse, elles sont masquées."
