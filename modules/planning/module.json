  "mcp": [
    {
      "name": "planning_upcoming",
      "readOnly": true,
      "default": true,
      "description": "List the upcoming streams of the schedule (title, start, end, games).",
      "input": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "description": "How many days ahead to list (1 to 60, default 7)."
          }
        }
      }
    }
  ],
  "seeds": [
    {
      "module": "calendar-ical",
      "reason": {
        "fr": "Reprendre l'adresse de votre agenda dans « Agenda en ligne »",
        "en": "Carry your calendar address over to “Online calendar”"
      }
    }
  ],
  "dataVersion": 3,
  "legacySettings": [
    {
      "key": "icsUrl",
      "secret": true
    }
  ],
  "overlayElements": [
    {
      "id": "week",
      "label": {
        "en": "Week schedule",
        "fr": "Planning de la semaine"
      },
      "description": {
        "en": "Your next streams, day by day. It needs room: a week grid when the frame is wide, a list when it is narrow.",
        "fr": "Vos prochains streams, jour par jour. Il demande de la place : une grille sur la semaine quand le cadre est large, une liste quand il est étroit."
      },
      "fit": "fluid",
      "ratios": {
        "min": 0.4,
        "max": 6
      },
      "minSize": {
        "width": 480,
        "height": 280
      },
      "followsStyle": true,
      "demo": true,
      "options": [
        {
          "id": "look",
          "type": "choice",
          "default": "auto",
          "label": {
            "en": "Look",
            "fr": "Apparence"
          },
          "help": {
            "en": "“Fit to the space” picks the grid or the list from the size of the frame.",
            "fr": "« Selon la place » choisit la grille ou la liste d'après la taille du cadre."
          },
          "choices": [
            {
              "value": "auto",
              "label": {
                "en": "Fit to the space",
                "fr": "Selon la place"
              }
            },
            {
              "value": "week",
              "label": {
                "en": "Week grid",
                "fr": "Semaine en grille"
              }
            },
            {
              "value": "classic",
              "label": {
                "en": "Classic list",
                "fr": "Liste classique"
              }
            },
            {
              "value": "alternating",
              "label": {
                "en": "Alternating list",
                "fr": "Liste en alternance"
              }
            },
            {
              "value": "timeline",
              "label": {
                "en": "Timeline",
                "fr": "Timeline"
              }
            },
            {
              "value": "posters",
              "label": {
                "en": "Posters",
                "fr": "Affiches"
              }
            }
          ]
        },
        {
          "id": "days",
          "type": "number",
          "min": 1,
          "max": 14,
          "integer": true,
          "default": 7,
          "label": {
            "en": "Number of days",
            "fr": "Nombre de jours"
          },
          "help": {
            "en": "From 1 to 14 days starting today.",
            "fr": "De 1 à 14 jours à partir d'aujourd'hui."
          },
          "example": "7"
        },
        {
          "id": "covers",
          "type": "boolean",
          "default": true,
          "label": {
            "en": "Show game covers",
            "fr": "Montrer les jaquettes"
          },
          "help": {
            "en": "The pictures of the games, when available. In a grid that is too short, they are hidden.",
            "fr": "Les images des jeux, quand elles sont disponibles. Dans une grille trop basse, elles sont masquées."
          }
        }
      ]
    },
    {
      "id": "next",
      "label": {
        "en": "Next stream",
        "fr": "Prochain stream"
      },
      "description": {
        "en": "The next stream, large: title, day, time, game and cover. The ones after it can be listed below.",
        "fr": "Le prochain stream en grand : titre, jour, heure, jeu et jaquette. Les suivants peuvent s'afficher en dessous."
      },
      "fit": "fluid",
      "ratios": {
        "min": 0.5,
        "max": 6
      },
      "minSize": {
        "width": 320,
        "height": 160
      },
      "followsStyle": true,
      "demo": true,
      "options": [
