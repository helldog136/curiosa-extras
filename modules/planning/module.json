{
  "apiVersion": 2,
  "id": "planning",
  "name": {
    "en": "Stream schedule",
    "fr": "Planning des streams"
  },
  "version": "2.0.0",
  "minCore": "0.1.16",
  "description": {
    "fr": "Affiche vos prochains streams, tirés de vos agendas en ligne, de ce que vous saisissez à la main ou de votre planning Twitch, dans l'apparence de votre choix : liste, alternance, semaine, timeline, affiches…",
    "en": "Shows your upcoming streams, taken from your online calendars, from what you type by hand or from your Twitch schedule, in the look you choose: list, zigzag, week, timeline, posters…"
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "📅",
  "main": "index.mjs",
  "type": "widget",
  "instances": "multiple",
  "page": true,
  "basePath": "planning",
  "sections": [
    {
      "id": "upcoming",
      "label": {
        "en": "Next streams",
        "fr": "Prochains streams"
      },
      "options": [
        {
          "key": "count",
          "type": "number",
          "default": 5,
          "label": {
            "en": "How many",
            "fr": "Combien"
          }
        },
        {
          "key": "appearance",
          "type": "select",
          "default": "inherit",
          "label": {
            "en": "Look",
            "fr": "Apparence"
          },
          "options": [
            {
              "value": "inherit",
              "label": {
                "en": "Same as the schedule page",
                "fr": "Comme la page du planning"
              }
            },
            {
              "value": "original",
              "label": {
                "en": "Simple list (original look)",
                "fr": "Liste simple (affichage d'origine)"
              }
            },
            {
              "value": "classic",
              "label": {
                "en": "Classic list",
                "fr": "Liste classique"
              }
            },
            {
              "value": "alternating",
              "label": {
                "en": "Alternating list",
                "fr": "Liste en alternance"
              }
            },
            {
              "value": "week",
              "label": {
                "en": "Week grid",
                "fr": "Semaine en grille"
              }
            },
            {
              "value": "timeline",
              "label": {
                "en": "Timeline",
                "fr": "Timeline"
              }
            },
            {
              "value": "posters",
              "label": {
                "en": "Posters",
                "fr": "Affiches"
              }
            },
            {
              "value": "hero",
              "label": {
                "en": "Spotlight + up next",
                "fr": "À la une + à suivre"
              }
            }
          ]
        }
      ],
      "size": "large"
    },
    {
      "id": "next",
      "label": {
        "en": "Next stream",
        "fr": "Prochain stream"
      },
      "size": "small"
    },
    {
      "id": "days",
      "label": {
        "en": "The next days (compact)",
        "fr": "Les prochains jours (miniature)"
      },
      "size": "medium",
      "options": [
        {
          "key": "count",
          "type": "number",
          "default": 3,
          "label": {
            "en": "How many days",
            "fr": "Combien de jours"
          }
        }
      ]
    }
  ],
  "provides": [
    {
      "topic": "planning.slot",
      "label": {
        "en": "Upcoming streams",
        "fr": "Prochains streams"
      }
    }
  ],
  "consumes": [
    {
      "topic": "calendar.event",
      "label": {
        "en": "Calendars that feed this schedule (online calendar, hand-written events, Twitch schedule…)",
        "fr": "Les calendriers qui alimentent ce planning (calendrier en ligne, évènements saisis à la main, planning Twitch…)"
      },
      "tags": true,
      "schema": [
        {
          "key": "id",
          "type": "string",
          "required": true
        },
        {
          "key": "title",
          "type": "string",
          "required": true
        },
        {
          "key": "start",
          "type": "datetime",
          "required": true
        },
        {
          "key": "end",
          "type": "datetime"
        },
        {
          "key": "allDay",
          "type": "boolean"
        },
        {
          "key": "description",
          "type": "string"
        },
        {
          "key": "location",
          "type": "string"
        },
        {
          "key": "url",
          "type": "url"
        },
        {
          "key": "status",
          "type": "string"
        },
        {
          "key": "category",
          "type": "string"
        },
        {
          "key": "color",
          "type": "string"
        },
        {
          "key": "sourceLabel",
          "type": "string"
        }
      ]
    },
    {
      "topic": "social.link",
      "label": {
        "en": "Your Twitch channel link (from the Twitch channel module)",
        "fr": "Le lien de votre chaîne (fourni par la Chaîne Twitch)"
      },
      "schema": [
        {
          "key": "label",
          "type": "string"
        },
        {
          "key": "url",
          "type": "url",
          "required": true
        },
        {
          "key": "icon",
          "type": "string"
        }
      ]
    }
  ],
  "permissions": [
    "pages",
    "routes",
    "sections",
    "admin",
    "topics",
    "mcp",
    "rawg"
  ],
  "settings": [
    {
      "key": "channelUrl",
      "type": "url",
      "label": {
        "en": "Channel link (“Watch on Twitch” button)",
        "fr": "Lien de votre chaîne (bouton « Regarder sur Twitch »)"
      },
      "help": {
        "en": "Optional. Not needed if the Twitch channel module is installed with your channel: its link is used. Without any link, the button is not shown.",
        "fr": "Facultatif. Inutile si la Chaîne Twitch est installée avec votre chaîne : son lien est repris. Sans lien, le bouton n'est pas affiché."
      }
    },
    {
      "key": "days",
      "type": "number",
      "default": 7,
      "advanced": true,
      "label": {
        "en": "Days shown on the page",
        "fr": "Jours affichés sur la page"
      }
    },
    {
      "key": "timezone",
      "type": "text",
      "default": "UTC",
      "advanced": true,
      "label": {
        "en": "Time zone",
        "fr": "Fuseau horaire"
      },
      "help": {
        "en": "IANA name, e.g. Europe/Paris, America/Montreal.",
        "fr": "Nom IANA, ex. Europe/Paris, America/Montreal."
      }
    },
    {
      "key": "appearance",
      "type": "select",
      "default": "original",
      "group": "appearance",
      "label": {
        "en": "Schedule look",
        "fr": "Apparence du planning"
      },
      "help": {
        "en": "How to show your streams, on the schedule page and in the “Next streams” home section. A preview of each choice is shown further down this page. “Simple list” is the look from before.",
        "fr": "Comment présenter vos streams, sur la page du planning et dans la section d'accueil « Prochains streams ». L'aperçu de chaque choix est affiché plus bas, sur cette page. « Liste simple » est l'affichage d'avant."
      },
      "options": [
        {
          "value": "original",
          "label": {
            "en": "Simple list (original look)",
            "fr": "Liste simple (affichage d'origine)"
          }
        },
        {
          "value": "classic",
          "label": {
            "en": "Classic list",
            "fr": "Liste classique"
          }
        },
        {
          "value": "alternating",
          "label": {
            "en": "Alternating list",
            "fr": "Liste en alternance"
          }
        },
        {
          "value": "week",
          "label": {
            "en": "Week grid",
            "fr": "Semaine en grille"
          }
        },
        {
          "value": "timeline",
          "label": {
            "en": "Timeline",
            "fr": "Timeline"
          }
        },
        {
          "value": "posters",
          "label": {
            "en": "Posters",
            "fr": "Affiches"
          }
        },
        {
          "value": "hero",
          "label": {
            "en": "Spotlight + up next",
            "fr": "À la une + à suivre"
          }
        }
      ]
    },
    {
      "key": "density",
      "type": "select",
      "default": "comfortable",
      "group": "appearance",
      "label": {
        "en": "Density",
        "fr": "Densité"
      },
      "help": {
        "en": "Compact fits more streams on screen. Also applies to the home “Next stream” card.",
        "fr": "Compacte : plus de streams à l'écran. S'applique aussi à la carte « Prochain stream » de l'accueil."
      },
      "options": [
        {
          "value": "comfortable",
          "label": {
            "en": "Comfortable",
            "fr": "Confortable"
          }
        },
        {
          "value": "compact",
          "label": {
            "en": "Compact",
            "fr": "Compacte"
          }
        }
      ]
    },
    {
      "key": "showCovers",
      "type": "boolean",
      "default": true,
      "group": "appearance",
      "label": {
        "en": "Show game covers",
        "fr": "Afficher les jaquettes des jeux"
      }
    },
    {
      "key": "showSource",
      "type": "boolean",
      "default": false,
      "group": "appearance",
      "label": {
        "en": "Show the source of each stream",
        "fr": "Montrer la source de chaque stream"
      },
      "help": {
        "en": "A small dot in the colour of its calendar, with its name, next to each stream. Useful when several calendars feed this schedule.",
        "fr": "Une petite pastille de la couleur de son calendrier, avec son nom, à côté de chaque stream. Utile quand plusieurs calendriers alimentent ce planning."
      }
    },
    {
      "key": "showRelative",
      "type": "boolean",
      "default": true,
      "group": "appearance",
      "label": {
        "en": "Show “In 3 h”, “Tomorrow”…",
        "fr": "Afficher « Dans 3 h », « Demain »…"
      }
    },
    {
      "key": "hourFormat",
      "type": "select",
      "default": "24",
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Time format",
        "fr": "Format de l'heure"
      },
      "options": [
        {
          "value": "24",
          "label": {
            "en": "24-hour (21:30)",
            "fr": "24 heures (21:30)"
          }
        },
        {
          "value": "12",
          "label": {
            "en": "12-hour (9:30 PM)",
            "fr": "12 heures (9:30 PM)"
          }
        }
      ]
    },
    {
      "key": "weekStart",
      "type": "select",
      "default": "1",
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "First day of the week",
        "fr": "Premier jour de la semaine"
      },
      "help": {
        "fr": "Pour l'apparence « Semaine en grille ».",
        "en": "For the “Week grid” look."
      },
      "options": [
        {
          "value": "1",
          "label": {
            "en": "Monday",
            "fr": "Lundi"
          }
        },
        {
          "value": "0",
          "label": {
            "en": "Sunday",
            "fr": "Dimanche"
          }
        },
        {
          "value": "6",
          "label": {
            "en": "Saturday",
            "fr": "Samedi"
          }
        }
      ]
    },
    {
      "key": "showTimezone",
      "type": "boolean",
      "default": false,
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Show the time zone under the schedule",
        "fr": "Rappeler le fuseau horaire sous le planning"
      }
    },
    {
      "key": "dayStyle",
      "type": "select",
      "default": "text",
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Day heading style",
        "fr": "Style des en-têtes de jour"
      },
      "options": [
        {
          "value": "text",
          "label": {
            "en": "Text (Monday 12 October)",
            "fr": "Texte (Lundi 12 octobre)"
          }
        },
        {
          "value": "tile",
          "label": {
            "en": "Tile (MON 12 OCT)",
            "fr": "Pastille (LUN 12 OCT)"
          }
        },
        {
          "value": "short",
          "label": {
            "en": "Short (Mon 12 Oct)",
            "fr": "Court (Lun. 12 oct.)"
          }
        }
      ]
    },
    {
      "key": "showEnd",
      "type": "boolean",
      "default": false,
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Also show the end time",
        "fr": "Afficher aussi l'heure de fin"
      }
    },
    {
      "key": "showCancelled",
      "type": "boolean",
      "default": false,
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Show cancelled streams (struck through)",
        "fr": "Montrer les streams annulés (barrés)"
      },
      "help": {
        "en": "An event marked “cancelled” stays visible, struck through, with a “Cancelled” label. No effect with “Simple list”.",
        "fr": "Un événement marqué « annulé » dans l'agenda reste visible, barré, avec la mention « Annulé ». Sans effet avec « Liste simple »."
      }
    },
    {
      "key": "classicHideEmpty",
      "type": "boolean",
      "default": false,
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Classic list: hide days without a stream",
        "fr": "Liste classique : masquer les jours sans stream"
      }
    },
    {
      "key": "altFirstSide",
      "type": "select",
      "default": "left",
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Alternating list: side of the first day",
        "fr": "Liste en alternance : côté du premier jour"
      },
      "options": [
        {
          "value": "left",
          "label": {
            "en": "Left",
            "fr": "Gauche"
          }
        },
        {
          "value": "right",
          "label": {
            "en": "Right",
            "fr": "Droite"
          }
        }
      ]
    },
    {
      "key": "weekMode",
      "type": "select",
      "default": "calendar",
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Week grid: weeks",
        "fr": "Semaine en grille : semaines"
      },
      "help": {
        "en": "Calendar: starts on the first day of the week. Rolling: seven days from today.",
        "fr": "Calendrier : commence le premier jour de la semaine. Glissantes : sept jours à partir d'aujourd'hui."
      },
      "options": [
        {
          "value": "calendar",
          "label": {
            "en": "Calendar weeks",
            "fr": "Semaines du calendrier"
          }
        },
        {
          "value": "rolling",
          "label": {
            "en": "Seven days from today",
            "fr": "Sept jours à partir d'aujourd'hui"
          }
        }
      ]
    },
    {
      "key": "timelineEmpty",
      "type": "boolean",
      "default": false,
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Timeline: also show days without a stream",
        "fr": "Timeline : montrer aussi les jours sans stream"
      }
    },
    {
      "key": "heroUpNext",
      "type": "number",
      "default": 5,
      "advanced": true,
      "group": "appearance",
      "label": {
        "en": "Spotlight: how many “up next” streams",
        "fr": "À la une : combien de streams « à suivre »"
      }
    }
  ],
  "mcp": [
    {
      "name": "planning_upcoming",
      "readOnly": true,
      "default": true,
      "description": "List the upcoming streams of the schedule (title, start, end, games).",
      "input": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        }
      }
    }
  ],
  "dataVersion": 2,
  "requires": [
    {
      "service": "calendar.provider"
    }
  ],
  "seeds": [
    {
      "module": "calendar-ical",
      "reason": {
        "fr": "Reprendre l'adresse de votre agenda dans un Calendrier iCal",
        "en": "Carry your calendar address over to an iCal calendar"
      }
    }
  ]
}
