{
  "apiVersion": 2,
  "id": "planning",
  "name": {
    "en": "Stream schedule",
    "fr": "Planning des streams"
  },
  "version": "1.1.0",
  "minCore": "0.1.10",
  "description": {
    "en": "Shows your upcoming streams, day by day, read from a Google Calendar (or any iCal feed).",
    "fr": "Affiche vos prochains streams, jour par jour, lus depuis un Google Agenda (ou n'importe quel flux iCal)."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "📅",
  "main": "index.mjs",
  "type": "widget",
  "instances": "multiple",
  "page": true,
  "basePath": "planning",
  "sections": [
    {
      "id": "upcoming",
      "label": {
        "en": "Next streams",
        "fr": "Prochains streams"
      },
      "options": [
        {
          "key": "count",
          "type": "number",
          "default": 5,
          "label": {
            "en": "How many",
            "fr": "Combien"
          }
        }
      ],
      "size": "large"
    },
    {
      "id": "next",
      "label": {
        "en": "Next stream",
        "fr": "Prochain stream"
      },
      "size": "small"
    },
    {
      "id": "days",
      "label": {
        "en": "The next days (compact)",
        "fr": "Les prochains jours (miniature)"
      },
      "size": "medium",
      "options": [
        {
          "key": "count",
          "type": "number",
          "default": 3,
          "label": {
            "en": "How many days",
            "fr": "Combien de jours"
          }
        }
      ]
    }
  ],
  "provides": [
    {
      "topic": "planning.slot",
      "label": {
        "en": "Upcoming streams",
        "fr": "Prochains streams"
      }
    }
  ],
  "permissions": [
    "pages",
    "routes",
    "sections",
    "admin",
    "topics",
    "mcp",
    "rawg"
  ],
  "settings": [
    {
      "key": "icsUrl",
      "type": "secret",
      "label": {
        "en": "Calendar address (iCal, secret)",
        "fr": "Adresse du calendrier (iCal, secrète)"
      },
      "help": {
        "en": "In Google Calendar: Settings → your calendar → “Secret address in iCal format”. Never shown again once saved.",
        "fr": "Dans Google Agenda : Paramètres → votre agenda → « Adresse secrète au format iCal ». Jamais réaffichée une fois enregistrée."
      }
    },
    {
      "key": "channelUrl",
      "type": "url",
      "label": {
        "en": "Channel link (“Watch on Twitch” button)",
        "fr": "Lien de votre chaîne (bouton « Regarder sur Twitch »)"
      },
      "help": {
        "en": "Optional, e.g. https://twitch.tv/mychannel. Without it, the button is not shown.",
        "fr": "Facultatif, ex. https://twitch.tv/machaine. Sans lien, le bouton n'est pas affiché."
      }
    },
    {
      "key": "days",
      "type": "number",
      "default": 7,
      "advanced": true,
      "label": {
        "en": "Days shown on the page",
        "fr": "Jours affichés sur la page"
      }
    },
    {
      "key": "timezone",
      "type": "text",
      "default": "UTC",
      "advanced": true,
      "label": {
        "en": "Time zone",
        "fr": "Fuseau horaire"
      },
      "help": {
        "en": "IANA name, e.g. Europe/Paris, America/Montreal.",
        "fr": "Nom IANA, ex. Europe/Paris, America/Montreal."
      }
    }
  ],
  "mcp": [
    {
      "name": "planning_upcoming",
      "readOnly": true,
      "default": true,
      "description": "List the upcoming streams of the schedule (title, start, end, games).",
      "input": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        }
      }
    }
  ]
}
