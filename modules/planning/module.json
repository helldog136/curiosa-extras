          }
        },
        {
          "value": "timeline",
          "label": {
            "en": "Timeline",
            "fr": "Timeline"
          }
        },
        {
          "value": "posters",
          "label": {
            "en": "Posters",
            "fr": "Affiches"
          }
        },
        {
          "value": "hero",
          "label": {
            "en": "Spotlight + up next",
            "fr": "À la une + à suivre"
          }
        }
      ]
    },
    {
      "key": "density",
      "type": "select",
      "default": "comfortable",
      "group": "appearance",
      "tab": "look",
      "label": {
        "en": "Density",
        "fr": "Densité"
      },
      "help": {
        "en": "Compact fits more streams on screen. Also applies to the home “Next stream” card.",
        "fr": "Compacte : plus de streams à l'écran. S'applique aussi à la carte « Prochain stream » de l'accueil."
