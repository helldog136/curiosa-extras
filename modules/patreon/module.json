{
  "apiVersion": 2,
  "id": "patreon",
  "name": {
    "en": "Patreon",
    "fr": "Patreon"
  },
  "version": "1.1.1",
  "platform": "patreon",
  "description": {
    "en": "Shows your Patreon button in the site header.",
    "fr": "Affiche le bouton de votre Patreon dans l'en-tête du site."
  },
  "author": "Helldog136",
  "license": "MIT",
  "icon": "🧡",
  "main": "index.mjs",
  "type": "social",
  "instances": "multiple",
  "page": false,
  "provides": [
    {
      "topic": "social.link",
      "label": {
        "en": "Patreon button in the header",
        "fr": "Bouton Patreon dans l'en-tête"
      }
    }
  ],
  "permissions": [],
  "settings": [
    {
      "key": "profile",
      "type": "text",
      "label": {
        "en": "Your profile address",
        "fr": "Adresse de votre profil"
      },
      "help": {
        "en": "Paste the link to your page.",
        "fr": "Collez le lien de votre page."
      },
      "example": {
        "en": "https://www.patreon.com/myname",
        "fr": "https://www.patreon.com/monpseudo"
      }
    }
  ],
  "minCore": "0.6.0",
  "social": {
    "name": "Patreon",
    "icon": "patreon",
    "hosts": [
      "patreon.com"
    ],
    "template": "https://www.patreon.com/{h}",
    "example": {
      "en": "https://www.patreon.com/myname",
      "fr": "https://www.patreon.com/monpseudo"
    },
    "shapes": [
      {
        "re": "^/@?(?!(?:c|user|join|posts|home|login|explore|settings)(?:/|$))([A-Za-z0-9._-]{1,60})/?$",
        "handle": true
      }
    ]
  }
}
