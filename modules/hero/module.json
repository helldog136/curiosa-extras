{
  "apiVersion": 2,
  "id": "hero",
  "name": {
    "en": "Home banner",
    "fr": "Bandeau d'accueil"
  },
  "version": "1.0.1",
  "main": "index.mjs",
  "description": {
    "en": "Big title and intro for the top of the home page. Place its section where you want it.",
    "fr": "Grand titre et introduction pour le haut de l'accueil. Placez sa section où vous voulez."
  },
  "author": "Helldog136",
  "license": "Curiosa License 1.0",
  "icon": "🏁",
  "onboarding": {
    "home": {
      "section": "hero"
    }
  },
  "consumes": [],
  "provides": [],
  "instances": "multiple",
  "sections": [
    {
      "id": "hero",
      "label": {
        "en": "Banner",
        "fr": "Bandeau"
      }
    }
  ],
  "permissions": [
    "sections"
  ],
  "settings": [
    {
      "key": "title",
      "type": "text",
      "translatable": true,
      "label": {
        "en": "Title",
        "fr": "Titre"
      },
      "help": {
        "en": "Shown in big letters. Follows the site name until you change it.",
        "fr": "Affiché en grand. Suit le nom du site tant que vous ne le changez pas."
      },
      "default": "site:name"
    },
    {
      "key": "text",
      "type": "textarea",
      "translatable": true,
      "label": {
        "en": "Intro",
        "fr": "Introduction"
      },
      "help": {
        "en": "Follows the site tagline until you change it.",
        "fr": "Suit l'accroche du site tant que vous ne la changez pas."
      },
      "default": "site:tagline"
    },
    {
      "key": "eyebrow",
      "type": "text",
      "translatable": true,
      "label": {
        "en": "Small line above the title",
        "fr": "Petite ligne au-dessus du titre"
      }
    },
    {
      "key": "buttonLabel",
      "type": "text",
      "translatable": true,
      "label": {
        "en": "Button text",
        "fr": "Texte du bouton"
      }
    },
    {
      "key": "buttonUrl",
      "type": "link",
      "label": {
        "en": "Where the button leads",
        "fr": "Où mène le bouton"
      }
    },
    {
      "key": "video",
      "type": "video",
      "label": {
        "en": "Video",
        "fr": "Vidéo"
      },
      "help": {
        "en": "MP4 or WebM, 50 MB at most. Keep it short and light (a few seconds in a loop). It only plays while on screen.",
        "fr": "MP4 ou WebM, 50 Mo au plus. Courte et légère (quelques secondes en boucle). Elle ne joue que lorsqu'elle est à l'écran."
      }
    },
    {
      "key": "poster",
      "type": "image",
      "label": {
        "en": "Image shown before playing",
        "fr": "Image affichée avant la lecture"
      },
      "help": {
        "en": "Also shown if the video cannot play.",
        "fr": "Aussi affichée si la vidéo ne peut pas se lancer."
      }
    },
    {
      "key": "videoSound",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Let visitors turn the sound on",
        "fr": "Permettre aux visiteurs d'activer le son"
      },
      "help": {
        "en": "The video always starts muted (browsers require it); a button lets visitors unmute it.",
        "fr": "La vidéo démarre toujours sans son (les navigateurs l'imposent) ; un bouton permet de l'activer."
      }
    },
    {
      "key": "showLogo",
      "type": "boolean",
      "default": true,
      "label": {
        "en": "Show the logo",
        "fr": "Afficher le logo"
      }
    }
  ],
  "optionalGroups": [
    {
      "id": "button",
      "label": {
        "en": "Button",
        "fr": "Bouton"
      },
      "addLabel": {
        "en": "Add a button",
        "fr": "Ajouter un bouton"
      },
      "removeLabel": {
        "en": "Remove the button",
        "fr": "Retirer le bouton"
      },
      "fields": [
        "buttonLabel",
        "buttonUrl"
      ],
      "required": [
        "buttonLabel",
        "buttonUrl"
      ]
    },
    {
      "id": "background",
      "label": {
        "en": "Background video",
        "fr": "Vidéo de fond"
      },
      "addLabel": {
        "en": "Add a background video for this section",
        "fr": "Ajouter une vidéo de fond pour cette section"
      },
      "removeLabel": {
        "en": "Remove the video",
        "fr": "Retirer la vidéo"
      },
      "fields": [
        "video",
        "poster",
        "videoSound"
      ],
      "required": [
        "video"
      ]
    }
  ]
}
